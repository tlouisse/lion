      // and the browser's console are two labelled sections rather than one stream that mixes them.
      const showReport = () => {
        const twoHalves = report.log.some(entry => entry.stream === 'browser');
        let text = twoHalves ? '── server · stdout\n' : '';
        let inBrowser = false;
        for (const entry of report.log) {
          if (entry.stream === 'browser' && !inBrowser) {
            inBrowser = true;
            text += '\n── client · browser console\n';
          }
          text += entry.stream === 'stderr' ? `! ${entry.text}` : entry.text;
        }
        output.textContent = text;
        filesList.textContent = '';
        for (const [pathname, content] of Object.entries(report.files || {})) {
          const item = document.createElement('li');
          item.textContent = `${pathname} (${content.length} chars)`;
          filesList.appendChild(item);
        }
      };


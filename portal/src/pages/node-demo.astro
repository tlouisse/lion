        const { label, hint } = modes[name];
        const labelSpan = document.createElement('span');
        labelSpan.className = 'mode-name';
        labelSpan.textContent = label;
        const hintSpan = document.createElement('span');
        hintSpan.className = 'mode-hint';
        hintSpan.textContent = hint;
        tab.append(labelSpan, ' ', hintSpan);
        tab.addEventListener('click', () => applyMode(name));
        modeTabs.appendChild(tab);
      }

      // Two arrangements of the same four parts, one per width.
      //
      // Desktop: the view model. One attribute on <body>, driven by the rail; show/hide lives in CSS, so there is one
      // source of truth, and the parts are laid out as if they were not there (see the stylesheet).
      const railButtons = [...document.querySelectorAll('.view-rail button')];
      const setView = view => {
        document.body.dataset.view = view;
        for (const button of railButtons) {
          button.classList.toggle('is-active', button.dataset.view === view);
        }
      };
      document.querySelector('.view-rail').addEventListener('click', event => {
        const button = event.target.closest('button[data-view]');
        if (button) setView(button.dataset.view);
      });
      setView('files');

      // Phone: the parts are an accordion, and the bottom bar drives it. A tap on the bar opens that part and scrolls
      // it into view. The parts are **independent** — several may be open at once — so the bar cannot mean "the open
      // one": it shows the part that is in view, which is what a reader is looking at and what a tap would move.
      // Nothing sets the `name` attribute here, because that is native exclusivity and it was explicitly not wanted.
      // Smooth scrolling, unless the user asked for reduced motion: then the jump is instant ('instant', not 'auto' —
      // 'auto' defers to the CSS `scroll-behavior`, which the portal sets smooth).
      const parts = [...document.querySelectorAll('details.part')];
      const barButtons = [...document.querySelectorAll('.mobile-tabs button')];
      const phone = window.matchMedia('(max-width: 48rem)');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const scrollBehavior = () => (reducedMotion.matches ? 'instant' : 'smooth');

      /** @type {string | null} */
      let partInView = null;

      const updateBar = () => {
        for (const button of barButtons) {
          const active = button.dataset.view === partInView;
          button.classList.toggle('is-active', active);
          if (active) button.setAttribute('aria-current', 'true');
          else button.removeAttribute('aria-current');
        }
      };

      const revealPart = part => {
        // After the layout has settled: a part that closed above this one has already given its height back.
        requestAnimationFrame(() => part.scrollIntoView({ behavior: scrollBehavior(), block: 'start' }));
      };

      const openPart = view => {
        const part = parts.find(candidate => candidate.dataset.part === view);
        if (!part) return;
        part.open = true;
        updateBar();
        revealPart(part);
      };

      for (const part of parts) {
        part.addEventListener('toggle', () => {
          if (!phone.matches || !part.open) return;
          // Opened from its own header: keep it in view if opening another part above moved its header off screen.
          const top = part.getBoundingClientRect().top;
          if (top < 48 || top > window.innerHeight - 57) revealPart(part);
        });
      }

      // Which part is in view. The rule is the last part whose top has passed the line a revealed part comes to rest
      // at — "which section fills the viewport" — rather than the topmost of those intersecting a band: with long
      // sections open, one that has already scrolled past still intersects, and picking it named the wrong part
      // (measured: the bar said preview while output filled the screen). The line is the parts' own
      // `scroll-margin-top`, so there is one source of truth for where a reveal lands instead of a second constant
      // that can drift. A passive scroll listener, throttled to a frame, keeps it right during a smooth scroll too.
      let revealLine = 0;
      const syncPartInView = () => {
        if (!phone.matches) {
          partInView = null;
          updateBar();
          return;
        }
        let current = null;
        for (const part of parts) {
          if (part.getBoundingClientRect().top <= revealLine + 1) current = part.dataset.part ?? null;
        }
        // Nothing has passed the line yet: the first part is what the reader is at.
        if (current === null) current = parts[0]?.dataset.part ?? null;
        if (current !== partInView) {
          partInView = current;
          updateBar();
        }
      };
      let scrollScheduled = false;
      window.addEventListener(
        'scroll',
        () => {
          if (scrollScheduled) return;
          scrollScheduled = true;
          requestAnimationFrame(() => {
            scrollScheduled = false;
            syncPartInView();
          });
        },
        { passive: true },
      );

      document.querySelector('.mobile-tabs').addEventListener('click', event => {
        const button = event.target.closest('button[data-view]');
        if (button && phone.matches) openPart(button.dataset.view);
      });

      // Entering a width sets its arrangement: on a phone the code is open and the rest are closed — closed only as a
      // default, not enforced, so opening several is fine. Above the breakpoint every part is open, because the
      // desktop lays them out side by side.
      const applyLayout = () => {
        if (phone.matches) {
          const keep = parts.find(part => part.dataset.part === 'code');
          for (const part of parts) part.open = part === keep;
        } else {
          for (const part of parts) part.open = true;
        }
        revealLine = parts.length ? parseFloat(getComputedStyle(parts[0]).scrollMarginTop) || 0 : 0;
        syncPartInView();
      };
      phone.addEventListener('change', applyLayout);
      applyLayout();

      applyMode('client');
    </script>

    <style is:global>
      /* One stylesheet, one design language. The block is `is:global` because almost everything it styles is
         global from Astro's point of view — the portal header (TopNav), Lion's tree and tabs, the playground
         elements' parts and custom properties, the items the script creates at runtime — and a page's styles
         only load on that page, so "global" here still means this page.

         The language, measured from StackBlitz's own stylesheet and kept in this page's dark family:
         - type: Inter for the UI at 400 / 500 / 600 (headings 600), JetBrains Mono for every code surface;
         - motion: 0.1s for state changes, 0.16s for movement, `ease`, nothing that bounces;
         - surfaces: no cards. The playground's regions are sections of one page, on the page's own background,
           separated by space and a hairline rule where a divider is genuinely needed. The code surfaces (editor,
           console) are bare, the way runware's docs set code — measured there: no border, no radius, no shadow, the
           code background and generous padding;
         - radius: only on controls (6px) and small things (4px) — never on a region or a code surface;
         - colour: one accent (their blue) for selection and focus, mint for success, red for failure. */
      :root {
        --pg-ui: Inter, system-ui, sans-serif;
        --pg-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

        /* light-dark() resolves against the `color-scheme` of the element that uses the value. The portal's
           theme.css sets that on <html> for light, dark and auto; this page pins its <body> to dark (below), so here
           these resolve to their dark half in every theme. */
        --pg-page: light-dark(#f4f4f5, #0b0b0d);
        --pg-page-fg: light-dark(#18181b, #ededef);
        --pg-page-muted: light-dark(#5f5f67, hsl(0 0% 62%));
        --pg-page-chip: light-dark(rgb(0 0 0 / 0.06), rgb(255 255 255 / 0.07));

        --pg-chrome: #0b0b0d; /* header and the phone's bottom bar */
        --pg-surface: #161618; /* panels and the rail */
        --pg-inset: #101012; /* editor, console, the mode control */
        --pg-strip: #131315; /* the tab strip and the preview toolbar */
        --pg-hover: rgb(255 255 255 / 0.05);
        --pg-selected: #26262b;
        --pg-line: rgb(255 255 255 / 0.07);
        --pg-line-strong: rgb(255 255 255 / 0.12);

        --pg-fg: #ededef;
        --pg-fg-2: #c2c2c8;
        --pg-muted: hsl(0 0% 62%);
        --pg-faint: #6c6c74;

        --pg-accent: rgb(0 168 219);
        --pg-ok: rgb(51 255 204);
        --pg-error: rgb(237 94 106);

        --pg-r: 6px;
        --pg-r-sm: 4px;
        --pg-fast: 0.1s ease;
        --pg-med: 0.16s ease;
      }

      /* The app is dark, and without panel surfaces its sections sit on the page's own background — so the page is the
         app's dark in every theme. A light page would put the app's light-grey text on near-white. The theme switch
         keeps governing the rest of the site; on this page it has nothing left to switch. */
      html body { color-scheme: dark; background-color: var(--pg-page); }

      main {
        margin: 0 auto;
        /* The header's own container size, so the logo and the playground below it share one left edge. Measured
           before: this page used 84rem here and 24px there while the header used 1600px and 40px, which put the
           content 32px right of the logo on a 1440px screen (48 + 24 against 0 + 40). */
        max-width: 1600px;
        /* 48px fixed header + 24px: the content clears the bar by the same 24px it keeps from the sides. */
        padding: 72px var(--page-gutter) 24px;
        font-family: var(--pg-ui);
        line-height: 1.5;
        color: var(--pg-page-fg);
      }
      [hidden] { display: none !important; }

      /* --- the header ------------------------------------------------------------------------------------------
         The header is `header.site-header`, and the portal's own rule for it wins over `body > header`,
         `header.site-header` and `html body header.site-header` alike — it carries `!important`, so there is no
         specificity left that wins. This page therefore marks `!important` on exactly the properties it changes:
         a 48px bar, fixed at the top, on the app's chrome colour with a hairline under it, the theme switch
         staying inside the navigation where TopNav renders it. Page-scoped: the docs site keeps its own header. */
      html body header.site-header {
        background: var(--pg-chrome) !important;
        backdrop-filter: none !important;
        border-bottom: 1px solid var(--pg-line) !important;
        display: flex !important;
        align-items: center !important;
        height: 48px !important;
        min-height: 48px !important;
        max-height: 48px !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        z-index: 50 !important;
        /* The wordmark's first half is `fill="currentColor"`, so it inherits this — setting the header's own
           colour is what keeps it light on the dark bar; targeting a/span/li never would. */
        color: var(--pg-fg);
      }
      html body header.site-header a,
      html body header.site-header span,
      html body header.site-header li,
      html body header.site-header button { color: var(--pg-muted); transition: color var(--pg-fast); }
      html body header.site-header a:hover,
      html body header.site-header button:hover { color: var(--pg-fg); }
      html body header.site-header .theme-switch label {
        color: var(--pg-muted); background: transparent; transition: color var(--pg-fast);
      }
      html body header.site-header .theme-switch [type='radio']:checked + label {
        color: var(--pg-fg); background: transparent;
      }

      /* The wordmark: both halves at weight 400 and the accent half in grey, so the mark reads as one quiet word.
         The component sets 600 on `.wordmark-glyphs`, so the selector matches that specificity and wins on order.
         Page-scoped on purpose: on the docs site the yellow and the heavier weight are deliberate.
         The accent half is also pulled back onto the spacing the mark has everywhere else: at 400 the glyphs of
         "lion" are narrower than the 600 they are drawn for, while "ui" keeps its authored x — measured as a 4.2px
         gap against the docs site's 2px. The transform applies in the SVG's own user units, which were 1:1 at the size
         the mark had when this was written (an 86-unit viewBox rendered at 86px, so -3.4px measured a 0.8px gap and
         -2.2px landed on 2px). If the mark is ever scaled, this value scales with it — verified after the mark went to
         72x30: the gap measured 1.7px, exactly proportional to the 2px both pages had before. */
      .logo-text-svg text.wordmark-glyphs { font-weight: 400; }
      .logo-text-svg text.wordmark-accent {
        fill: var(--pg-muted);
        stroke: none;
        transform: translateX(-2.2px);
      }

      /* --- the intro: type on the page, not another box ------------------------------------------------------ */
      main > header { margin: 0 0 16px; text-align: left; }
      .lede {
        margin: 0;
        max-width: 76ch;
        font-size: 14px;
        line-height: 1.6;
        color: var(--pg-page-muted);
      }
      .lede strong { font-weight: 500; color: var(--pg-page-fg); }
      .lede code {
        font-family: var(--pg-mono);
        font-size: 12.5px;
        padding: 1px 3px;
        border-radius: var(--pg-r-sm);
        background: var(--pg-page-chip);
        color: inherit;
      }

      /* --- focus: one ring for every control in the app -----------------------------------------------------
         The portal's global rule draws a dotted outline; the app replaces it with the accent, solid. */
      .playground-app :is(button, summary, [role='tab'], [role='treeitem']):focus-visible,
      .mobile-tabs button:focus-visible {
        outline: 2px solid var(--pg-accent);
        outline-offset: 2px;
      }

      /* --- the toolbar: the mode switch is a segmented control ---------------------------------------------- */
      .toolbar.playground-app {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 0 0 16px;
      }
      /* On the page itself: no well around the control, only the selected mode carries a fill. */
      #modes {
        display: inline-flex;
        gap: 4px;
      }
      #modes [role='tab'] {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        height: 30px;
        padding: 0 12px;
        border: 0;
        border-radius: var(--pg-r);
        background: transparent;
        color: var(--pg-muted);
        font: 500 13px/30px var(--pg-ui);
        white-space: nowrap;
        cursor: pointer;
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      #modes .mode-hint { font-weight: 400; color: var(--pg-faint); transition: color var(--pg-fast); }
      #modes [role='tab']:hover { color: var(--pg-fg); background: var(--pg-hover); }
      #modes [role='tab'][aria-selected='true'] {
        color: var(--pg-fg);
        background: var(--pg-selected);
      }
      #modes [role='tab'][aria-selected='true'] .mode-hint { color: var(--pg-muted); }
      #modes [role='tab']:active { background: var(--pg-selected); }

      /* --- the app grid: rail, project, run — all three stretched to one bottom edge ------------------------- */
      .playground.playground-app {
        display: grid;
        grid-template-columns: auto minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 24px;
        align-items: stretch;
      }

      /* The editor's look, assigned through the custom properties playground-elements ships for exactly this —
         the palette is configuration, never a reach into its shadow DOM. */
      .playground-app {
        --playground-code-background: var(--pg-inset);
        --playground-code-default-color: #d4d4d8;
        --playground-code-font-family: var(--pg-mono);
        --playground-code-font-size: 13.5px;
        --playground-code-line-height: 1.7;
        --playground-code-padding: 12px 0;
        --playground-code-line-padding: 0 16px 0 12px;
        --playground-code-gutter-background: var(--pg-inset);
        --playground-code-gutter-border-right: 0;
        --playground-code-gutter-box-shadow: none;
        --playground-code-linenumber-color: #4b4b53;
        --playground-code-cursor-color: var(--pg-accent);
        --playground-code-selection-background: #1d3b52;
        --playground-highlight-color: #1d3b52;
        --playground-code-comment-color: #6b7280;
        --playground-code-keyword-color: #c586c0;
        --playground-code-string-color: #ce9178;
        --playground-code-string-2-color: #d7ba7d;
        --playground-code-number-color: #b5cea8;
        --playground-code-variable-color: #9cdcfe;
        --playground-code-variable-2-color: #9cdcfe;
        --playground-code-variable-3-color: #4ec9b0;
        --playground-code-def-color: #dcdcaa;
        --playground-code-type-color: #4ec9b0;
        --playground-code-tag-color: #569cd6;
        --playground-code-attribute-color: #9cdcfe;
        --playground-code-property-color: #9cdcfe;
        --playground-code-operator-color: #d4d4d8;
        --playground-code-meta-color: #d7ba7d;
        --playground-code-atom-color: #569cd6;
        --playground-code-builtin-color: #4ec9b0;
        --playground-code-callee-color: #dcdcaa;
        --playground-code-qualifier-color: #dcdcaa;
        --playground-border: 1px solid var(--pg-line);
        --playground-bar-height: 36px;
        --playground-floating-controls-color: var(--pg-muted);
        --playground-preview-toolbar-background: var(--pg-strip);
        --playground-preview-toolbar-foreground-color: var(--pg-muted);
        --playground-tab-bar-background: var(--pg-strip);
        --playground-tab-bar-foreground-color: var(--pg-muted);
        --playground-tab-bar-active-color: var(--pg-fg);
        --playground-tab-bar-active-background: var(--pg-inset);
        --playground-tab-bar-font-size: 12px;
      }

      /* --- the view rail: an activity bar, full height, on the page — the panel beside it draws the divider ---- */
      .view-rail {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        width: 48px;
        padding: 6px 0;
        align-self: stretch;
      }
      .view-rail button {
        position: relative;
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: var(--pg-r);
        background: transparent;
        color: var(--pg-faint);
        cursor: pointer;
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      .view-rail button:hover { color: var(--pg-fg-2); background: var(--pg-hover); }
      .view-rail button.is-active { color: var(--pg-fg); background: var(--pg-selected); }
      /* The active marker sits on the rail's edge, the way an activity bar marks the open view. */
      .view-rail button::before {
        content: '';
        position: absolute;
        left: -6px;
        top: 9px;
        bottom: 9px;
        width: 2px;
        border-radius: 0 2px 2px 0;
        background: var(--pg-accent);
        opacity: 0;
        transform: scaleY(0.4);
        transition: opacity var(--pg-med), transform var(--pg-med);
      }
      .view-rail button.is-active::before { opacity: 1; transform: none; }
      .view-rail button.is-active .material-symbols-outlined { font-variation-settings: 'FILL' 1; }

      /* --- sections ----------------------------------------------------------------------------------------- *
         Not cards: no surface, no radius, no shadow. Each column is a section of the page, divided from the one
         before it by a hairline down its left edge — the one divider the columns genuinely need. The 16px inset
         stays, so the tree, the tabs and the editor keep their measured left edge (40 + 48 rail + 24 + 16 = 128). */
      .playground-app .pane {
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 0 16px 16px;
        box-shadow: inset 1px 0 0 var(--pg-line);
        color: var(--pg-fg-2);
      }
      /* The section title is a header row across the full section, divided from the body by a hairline rule. */
      .playground-app .pane h2 {
        display: flex;
        align-items: center;
        height: 40px;
        margin: 0 -16px 12px;
        padding: 0 16px;
        box-shadow: inset 0 -1px 0 var(--pg-line);
        font: 600 11.5px/1 var(--pg-ui);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--pg-muted);
      }

      /* The code surfaces, all in the editor's face, size and rhythm. */
      .playground-app :is(#file-tree [role='treeitem'], #open-files [slot='tab'], .terminal, #files li) {
        font-family: var(--pg-mono);
        font-size: 13.5px;
        line-height: 1.7;
      }

      /* Material Symbols turns ligature text into an icon: without these mechanics the words show up as words. */
      .material-symbols-outlined {
        font-family: 'Material Symbols Outlined', sans-serif;
        font-weight: normal;
        font-style: normal;
        font-size: 20px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        display: inline-block;
        font-feature-settings: 'liga';
        font-variation-settings: 'FILL' 0, 'wght' 400, 'opsz' 20;
        -webkit-font-smoothing: antialiased;
      }

      /* --- the file tree -------------------------------------------------------------------------------------
         Padding 0 on the tree itself, so the tree, the tab strip and the editor start on one left edge.
         The tree is structure, the tab strip below it is open documents, and the two must not look alike: the tree
         is a vertical outline — full-width rows, a disclosure chevron on folders, children indented under a
         hairline guide — with no strip, no separators and no accent edge. Those belong to the tabs. */
      .playground-app #file-tree { display: block; padding: 0; margin: 0 0 12px; }
      /* A nested level: indented under its folder, the guide running down from the folder's chevron. */
      .playground-app #file-tree demo-tree {
        display: block;
        margin-left: 11px;
        padding-left: 4px;
        box-shadow: inset 1px 0 0 var(--pg-line);
      }
      .playground-app #file-tree [role='treeitem'] {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 26px;
        padding: 0 8px 0 4px;
        border-radius: var(--pg-r-sm);
        color: var(--pg-muted);
        cursor: pointer;
        user-select: none;
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      /* The chevron column: a disclosure on folders, an empty slot of the same width on files, so names align. */
      .playground-app #file-tree [role='treeitem']::before {
        content: '';
        flex: none;
        width: 16px;
        font: normal 16px/1 'Material Symbols Outlined';
        font-feature-settings: 'liga';
        letter-spacing: normal;
        text-transform: none;
        color: var(--pg-faint);
        transition: transform var(--pg-med);
      }
      .playground-app #file-tree [role='treeitem'][data-folder]::before { content: 'expand_more'; }
      .playground-app #file-tree [role='treeitem'][aria-expanded='false']::before { transform: rotate(-90deg); }
      .playground-app #file-tree [role='treeitem'][data-folder] { color: var(--pg-fg-2); }
      .playground-app #file-tree [role='treeitem']:hover { color: var(--pg-fg); background: var(--pg-hover); }
      /* The file that is open is marked in the tree too, so the tree and the tabs agree — as a quiet row
         highlight, not as a second selected tab. */
      .playground-app #file-tree [role='treeitem'][aria-current] { color: var(--pg-fg); background: var(--pg-hover); }
      .playground-app #file-tree [role='treeitem'] .material-symbols-outlined { font-size: 18px; color: var(--pg-faint); }
      /* The icons are centred on the row and so is the label's line box, but a lowercase mono label's ink sits below
         its box's centre: measured at 3x, the file-type badges read about 1px high. A transform moves the glyph
         without moving the layout (the row heights and the shared left edge stay as measured). */
      .playground-app :is(#file-tree [role='treeitem'], #open-files [slot='tab']) > .material-symbols-outlined {
        transform: translateY(1px);
      }
      .playground-app #file-tree [role='treeitem'][aria-current] .material-symbols-outlined { color: var(--pg-accent); }
      /* The two top-level folders are the split itself: each says where it runs, in the UI's quieter voice. */
      .playground-app #file-tree [role='treeitem'][data-side] { color: var(--pg-fg); }
      .playground-app #file-tree [role='treeitem'][data-side] .material-symbols-outlined { color: var(--pg-muted); }
      .playground-app #file-tree .tree-hint {
        margin-left: auto;
        padding-left: 12px;
        font: 400 12px/1 var(--pg-ui);
        color: var(--pg-faint);
        white-space: nowrap;
      }

      /* --- open files: a tab strip that sits on the editor ---------------------------------------------------
         Tabs scroll horizontally instead of wrapping, and the scroller is this page's own: Lion's tab group has no
         reachable shadow root (measured: `shadowRoot` null, host `display: block`), so its internals cannot be
         asked to scroll. The host grows to its content inside a scrolling wrapper, which works either way. */
      .tab-scroller {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
        scrollbar-color: #3a3a42 transparent;
        background: var(--pg-strip);
        /* No frame: a hairline under the strip only, which the selected tab paints over with the editor's
           background, so the tab and the editor read as one bare sheet. */
        box-shadow: inset 0 -1px 0 var(--pg-line);
      }
      /* When the tabs do not fit, the edge they continue past fades out, so the strip reads as a scroller. */
      .tab-scroller.is-overflowing:not(.is-at-end) {
        mask-image: linear-gradient(to right, #000 calc(100% - 56px), transparent);
      }
      .tab-scroller::-webkit-scrollbar { height: 6px; }
      .tab-scroller::-webkit-scrollbar-thumb { background: #3a3a42; border-radius: 3px; }
      .playground-app #open-files { display: block; position: relative; z-index: 1; width: max-content; min-width: 100%; margin: 0; }
      .playground-app #open-files [slot='tab'] {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 6px;
        height: 36px;
        padding: 0 6px 0 12px;
        white-space: nowrap;
        user-select: none;
        cursor: pointer;
        color: var(--pg-muted);
        background: transparent;
        box-shadow: inset -1px 0 0 var(--pg-line);
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      .playground-app #open-files [slot='tab']:hover { color: var(--pg-fg-2); background: var(--pg-hover); }
      /* The active tab is the ARIA state this page owns (Lion does not decorate tabs it did not add), so the
         highlight follows `aria-selected`. It takes the editor's background, so tab and editor read as one sheet. */
      .playground-app #open-files [slot='tab'][aria-selected='true'] {
        color: var(--pg-fg);
        background: var(--pg-inset);
        box-shadow: inset 0 2px 0 var(--pg-accent), inset -1px 0 0 var(--pg-line);
      }
      .playground-app #open-files [slot='tab'].dragging { opacity: 0.4; }
      .playground-app #open-files [slot='tab'] > .material-symbols-outlined { font-size: 18px; color: var(--pg-faint); }
      .playground-app #open-files [slot='tab'] .close {
        display: grid;
        place-items: center;
        width: 20px;
        height: 20px;
        padding: 0;
        border: 0;
        border-radius: var(--pg-r-sm);
        background: transparent;
        color: var(--pg-muted);
        cursor: pointer;
        opacity: 0;
        transition: opacity var(--pg-fast), color var(--pg-fast), background-color var(--pg-fast);
      }
      .playground-app #open-files [slot='tab'] .close .material-symbols-outlined { font-size: 16px; }
      .playground-app #open-files [slot='tab']:is(:hover, [aria-selected='true']) .close,
      .playground-app #open-files [slot='tab'] .close:focus-visible { opacity: 1; }
      .playground-app #open-files [slot='tab'] .close:hover { color: var(--pg-fg); background: var(--pg-line-strong); }
      .playground-app #open-files [slot='tab']:focus-visible { outline-offset: -2px; }
      /* Lion's tabs require a panel per tab; the editor is the panel here, so the empty ones take no space. */
      #open-files [slot='panel'] { display: none !important; }

      /* --- the editor: bare code, filling what is left of the section so it never ends in dead space -------- */
      .playground-app #editor {
        display: block;
        flex: 1 0 30rem;
        min-height: 0;
        overflow: hidden;
        background: var(--pg-inset);
      }

      /* --- the run panel ------------------------------------------------------------------------------------- */
      /* The status is a row: a state dot and one line of text. The dot follows `data-state`, set by the script. */
      .playground-app .status {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 12px;
        font-size: 13px;
        line-height: 1.5;
        color: var(--pg-fg-2);
      }
      .playground-app #status::before {
        content: '';
        flex: none;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--pg-faint);
        transition: background-color var(--pg-med), box-shadow var(--pg-med);
      }
      .playground-app #status[data-state='running']::before { background: var(--pg-accent); box-shadow: 0 0 0 3px rgb(0 168 219 / 0.18); }
      .playground-app #status[data-state='ok']::before { background: var(--pg-ok); box-shadow: 0 0 0 3px rgb(51 255 204 / 0.14); }
      .playground-app #status[data-state='error']::before { background: var(--pg-error); box-shadow: 0 0 0 3px rgb(237 94 106 / 0.16); }

      .playground-app #busy { display: flex; align-items: center; gap: 8px; margin: -4px 0 12px; }
      .playground-app lion-progress-indicator { --lion-progress-indicator-size: 16px; }

      /* The preview is a light canvas on the dark page: the served document is somebody else's page and renders on
         white, and a transparent iframe shows the host through. It sits *in* the page rather than glaring out of it:
         an off-white (#f3f3f4, the value the demos' shared styles.css paints too) and a soft inner shadow under the
         toolbar, so the canvas reads as recessed. No frame and no radius: it is a region, not a card. */
      /* No `display` here: the element's own `:host` is a flex column whose `#content` takes `flex: 1`, and that
         is what sizes the iframe to the frame. Forcing `display: block` (as this page used to) leaves the iframe at
         the browser's default 150px, and anything below that line in the canvas is cut off. */
      .playground-app #preview {
        position: relative;
        height: 18rem;
        overflow: hidden;
        background: #f3f3f4;
      }
      /* Drawn over the iframe, below the toolbar, and never in the way of the pointer. */
      .playground-app #preview::after {
        content: '';
        position: absolute;
        inset: var(--playground-bar-height) 0 0;
        pointer-events: none;
        box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.14), inset 0 0 0 1px rgb(0 0 0 / 0.05);
      }
      #preview::part(preview-toolbar) { border-bottom: 1px solid var(--pg-line); font-family: var(--pg-ui); font-size: 12px; }
      #preview::part(preview-reload-button) { color: var(--pg-muted); transition: color var(--pg-fast); }
      #preview::part(preview-reload-button):hover { color: var(--pg-fg); }

      /* A server has no page. The preview still runs — the harness in it is where the server code executes — so it is
         taken out of sight without being taken out of the document (`display: none` is not a risk worth taking with
         the frame that runs the code), and an empty state says where the result is instead. */
      .no-page { display: none; }
      body[data-mode='server'] .playground-app #preview {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        border: 0;
      }
      body[data-mode='server'] .playground-app .no-page {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 4px 0 8px;
        color: var(--pg-muted);
        font-size: 13px;
        line-height: 1.5;
      }
      .playground-app .no-page p { margin: 0; }
      .playground-app .no-page .material-symbols-outlined { font-size: 22px; color: var(--pg-faint); }

      /* The console: bare code, like the editor — the code background and generous padding, no frame. Empty, it says
         what will appear in it rather than being a blank block. */
      .playground-app .terminal {
        margin: 16px 0 0;
        padding: 16px 20px;
        min-height: 3rem;
        max-height: 16rem;
        overflow: auto;
        white-space: pre-wrap;
        background: var(--pg-inset);
        color: var(--pg-fg-2);
        scrollbar-width: thin;
        scrollbar-color: #3a3a42 transparent;
      }
      .playground-app .terminal:empty::before {
        content: 'Console output appears here when the program runs.';
        font-family: var(--pg-ui);
        font-size: 13px;
        color: var(--pg-faint);
      }
      /* The files the program wrote are the console's footer, on the same code background and text column, divided
         from the output by a hairline. */
      .playground-app #files {
        list-style: none;
        margin: 0;
        padding: 12px 20px 16px;
        background: var(--pg-inset);
        box-shadow: inset 0 1px 0 var(--pg-line);
      }
      .playground-app #files:empty { display: none; }
      .playground-app #files li { color: var(--pg-muted); }

      /* The checks disclosure is this page's own: Lion's accordion cannot be themed (see the markup comment). It is a
         section, not a box: a hairline rule above it, and its label and content on the section's own text column —
         the column the status line and the notes use. */
      .playground-app .checks {
        margin: 16px 0 0;
        border-top: 1px solid var(--pg-line);
        font-size: 13px;
        color: var(--pg-fg-2);
      }
      .playground-app .checks summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 40px;
        padding: 0;
        list-style: none;
        cursor: pointer;
        font: 600 11.5px/1 var(--pg-ui);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--pg-muted);
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      .playground-app .checks summary::-webkit-details-marker { display: none; }
      .playground-app .checks summary:hover { color: var(--pg-fg-2); }
      .playground-app .checks summary::after {
        content: 'expand_more';
        font: normal 18px/1 'Material Symbols Outlined';
        font-feature-settings: 'liga';
        letter-spacing: normal;
        text-transform: none;
        transition: transform var(--pg-med);
      }
      .playground-app .checks[open] summary::after { transform: rotate(180deg); }
      .playground-app .checks > p:first-of-type { margin-top: 4px; }
      .playground-app .checks > :last-child { margin-bottom: 4px; }
      .playground-app .checks .status { display: block; margin-bottom: 8px; font-size: 13px; }
      .playground-app :is(#governance, #boundary)[data-consistent='false'] { color: var(--pg-error); }
      .playground-app .checks h3 {
        margin-top: 16px;
        margin-bottom: 8px;
        font: 600 11.5px/1 var(--pg-ui);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--pg-muted);
      }
      .playground-app #findings { margin-top: 0; margin-bottom: 8px; padding-left: 0; list-style: none; font-family: var(--pg-mono); font-size: 12.5px; color: var(--pg-muted); }
      .playground-app #packages { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 0; margin-bottom: 0; padding: 0; list-style: none; }
      .playground-app #packages li {
        padding: 1px 6px;
        border-radius: var(--pg-r-sm);
        background: var(--pg-hover);
        font-family: var(--pg-mono);
        font-size: 12px;
        color: var(--pg-fg-2);
      }
      .playground-app .checks .note { margin-top: 12px; }

      .playground-app .note { margin: 12px 0 0; max-width: 68ch; font-size: 13px; line-height: 1.6; color: var(--pg-muted); }
      .playground-app code { font-family: var(--pg-mono); font-size: 12.5px; color: #ce9178; }

      /* --- the parts ------------------------------------------------------------------------------------------
         Four native disclosures wrap the content (see the markup). Their two arrangements follow. */
      .part-head { list-style: none; }
      .part-head::-webkit-details-marker { display: none; }

      /* --- desktop: two columns and the view model ---------------------------------------------------------------
         The parts are not boxes here: `display: contents` on the disclosure and on its content slot makes their
         children lay out as children of the column, exactly as without them, and the summaries are not shown — the
         rail is how a desktop switches. (`::details-content` is its own rule: a browser without it drops only that
         rule, and still gets the hidden summaries and the open parts.) */
      @media (min-width: 48.01rem) {
        .part { display: contents; }
        .part > summary { display: none; }

        /* The view model: one attribute on <body>, driven by the rail; show/hide lives here so there is one source
           of truth. `files` is the full layout — the rail switches focus, not the editor out of existence, which is
           how an activity bar behaves. `code` is that view with the tree folded away, and the last two are the run
           pane alone. */
        body[data-view='code'] #file-tree,
        body[data-view='code'] #pane-run { display: none; }
        body[data-view='preview'] #pane-project,
        body[data-view='output'] #pane-project { display: none; }
        body[data-view='preview'] #node-panes,
        body[data-view='preview'] .checks,
        body[data-view='preview'] #mode-note { display: none; }
        body[data-view='output'] #preview,
        body[data-view='output'] .no-page { display: none !important; }
        /* A focused view gets the whole width beside the rail, not a narrow column. */
        body[data-view='preview'] #pane-run,
        body[data-view='output'] #pane-run { grid-column: 2 / -1; }
        /* With the preview gone, the console is the view: it starts at the top of the section. */
        body[data-view='output'] .playground-app .terminal { margin-top: 0; }
      }
      @media (min-width: 48.01rem) {
        .part::details-content { display: contents; }
      }

      .mobile-tabs { display: none; }

      /* --- a phone: the four parts stacked as an accordion, driven by a fixed bar at the bottom ----------------- */
      @media (max-width: 48rem) {
        /* 48px header + 12px on top; the 57px bar + 27px underneath, so the last line is never under the bar. */
        main { padding: 60px var(--page-gutter) 84px; }
        main > header .lede { display: none; }

        .toolbar.playground-app { display: block; }
        #modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; }
        #modes [role='tab'] { justify-content: center; height: 40px; line-height: 40px; padding: 0 8px; }
        #modes .mode-hint { display: none; }

        /* One column of parts, one after the other: no columns, no section titles (each part has its own header),
           no column divider. */
        .playground.playground-app { grid-template-columns: minmax(0, 1fr); gap: 0; }
        .view-rail { display: none; }
        .playground-app .pane { padding: 0; box-shadow: none; }
        .playground-app .pane h2 { display: none; }

        /* A part: its header is a full-width row with a hairline rule above it; the open part's chevron turns. The
           header clears the fixed site header when the bar scrolls a part into view. */
        .part { scroll-margin-top: 56px; border-top: 1px solid var(--pg-line); }
        #pane-run .part:last-child { border-bottom: 1px solid var(--pg-line); }
        .part-head {
          display: flex;
          align-items: center;
          gap: 10px;
          min-height: 48px;
          cursor: pointer;
          font: 600 12px/1 var(--pg-ui);
          letter-spacing: 0.08em;
          text-transform: uppercase;
          color: var(--pg-muted);
          -webkit-tap-highlight-color: transparent;
          transition: color var(--pg-fast);
        }
        .part-head .material-symbols-outlined { font-size: 20px; color: var(--pg-faint); }
        .part-head::after {
          content: 'expand_more';
          margin-left: auto;
          font: normal 20px/1 'Material Symbols Outlined';
          font-feature-settings: 'liga';
          letter-spacing: normal;
          text-transform: none;
          color: var(--pg-faint);
          transition: transform var(--pg-med);
        }
        .part[open] > .part-head { color: var(--pg-fg); }
        .part[open] > .part-head .material-symbols-outlined { color: var(--pg-accent); }
        .part[open] > .part-head::after { transform: rotate(180deg); }
        .part[open] { padding-bottom: 16px; }

        /* The code, bare and full width, a screenful tall at most so the next part's header stays reachable. */
        .playground-app #editor { flex: none; height: min(60dvh, 28rem); }
        .playground-app #preview { height: 22rem; }
        .playground-app .terminal { margin-top: 0; }
        .playground-app #status { margin-top: 0; }

        /* Phone-sized hit areas. */
        .playground-app #file-tree { margin: 0; }
        .playground-app #file-tree [role='treeitem'] { height: 40px; }
        .playground-app #open-files [slot='tab'] { height: 40px; }
        .playground-app #open-files [slot='tab'] .close { width: 28px; height: 28px; opacity: 1; }

        /* The bar: fixed, safe-area aware, four parts in four columns, 56px touch targets plus its hairline. */
        .mobile-tabs {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 20;
          font-family: var(--pg-ui);
          background: var(--pg-chrome);
          border-top: 1px solid var(--pg-line);
          padding-bottom: env(safe-area-inset-bottom, 0);
        }
        .mobile-tabs button {
          position: relative;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 3px;
          min-height: 56px;
          padding: 6px 0;
          border: 0;
          background: transparent;
          color: var(--pg-muted);
          font: 500 11px/1.2 var(--pg-ui);
          letter-spacing: 0.01em;
          cursor: pointer;
          -webkit-tap-highlight-color: transparent;
          transition: color var(--pg-fast), background-color var(--pg-fast);
        }
        .mobile-tabs button .material-symbols-outlined { font-size: 22px; }
        .mobile-tabs button.is-active { color: var(--pg-fg); }
        .mobile-tabs button.is-active .material-symbols-outlined { color: var(--pg-accent); font-variation-settings: 'FILL' 1; }
        .mobile-tabs button::before {
          content: '';
          position: absolute;
          top: -1px;
          left: 50%;
          width: 24px;
          height: 2px;
          margin-left: -12px;
          border-radius: 0 0 2px 2px;
          background: var(--pg-accent);
          opacity: 0;
          transition: opacity var(--pg-med);
        }
        .mobile-tabs button.is-active::before { opacity: 1; }
        .mobile-tabs button:active { background: var(--pg-hover); }
        .mobile-tabs button:focus-visible { outline-offset: -4px; }
      }

      /* On a touch screen there is no hover to reveal a tab's close button, so it is always there. */
      @media (hover: none) {
        .playground-app #open-files [slot='tab'] .close { opacity: 1; }
      }

      @media (prefers-reduced-motion: reduce) {
        /* The portal scrolls the page smoothly; asked for reduced motion, a jump to a part is instant. */
        html { scroll-behavior: auto; }
        .playground-app *,
        .playground-app *::before,
        .playground-app *::after,
        .mobile-tabs *,
        .mobile-tabs *::before { transition: none !important; }
      }
    </style>
  </body>
</html>

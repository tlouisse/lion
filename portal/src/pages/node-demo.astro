                  file,
                  line: index + 1,
                  specifier,
                  message: `${where} imports "${specifier}", which is server code — client/ runs in the browser, and server/ is never sent to it. Have the server send its result to the client instead.`,
                });
              }
            }
          });
        }
        return violations;
      }

      // The harness: what a real setup splits over a server process, a network and a browser, played in the one
      // document the preview serves. It is a hidden project file because it is not part of the app — it is how the
      // app runs here — and it does three things in the order a real deployment does them:
      //  1. the build: the boundary check above, over the files as they are *now* (edits included); a violation
      //     fails the run before any code executes, with the message a bundler would give;
      //  2. the server: its entry is imported by its served url, not as a blob, so its relative imports and

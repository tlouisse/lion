          if (!file.startsWith('client/') || typeof content !== 'string') continue;
          content.split('\n').forEach((text, index) => {
            for (const match of text.matchAll(/(?:\bfrom\s*|\bimport\s*\(?\s*)(['"])([^'"\n]+)\1/g)) {
              let specifier = match[2];

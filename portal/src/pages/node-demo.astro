---
// Two ways to run a demo, both inside an opaque-origin fence.
//
// `browser` mode is the playground's own model: `index.html` *is* the document, `main.js` is its module, and
// nothing else is involved — no shims, no virtual filesystem, no engine. Its document builder is the share
// fence's, shipped next to this page (see the portal's predev/prebuild), so the rules for extracting the body
// markup, rewriting a demo's relative imports to in-sandbox blob urls and importing the registry stay in one
// place.
//
// `node` mode runs a file through the dependency-free Node layer: the engine seeds the shims' filesystem,
// imports the entry and reports output, exit code and the resulting files.
//
// In both modes the code runs in a `sandbox="allow-scripts"` frame with no access to this origin's cookies,
// storage, parent dom or service workers — and in both the frame is shown, so a component demo renders in the
// preview rather than in this page.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetsBase = `${base}lion-playground-node-demo`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>Demo — Lion</title>
  </head>
  <body>
    <main>
      <h1>Demo</h1>
      <p class="lede">
        Two modes, one fence. <strong>browser</strong> renders <code>index.html</code> as the document with
        <code>main.js</code> as its module — the playground's own model. <strong>node</strong> runs a file
        through a dependency-free Node layer (<code>fs</code>, <code>path</code>, <code>process</code>,
        <code>os</code>, <code>util</code>, <code>events</code>, <code>url</code>) and can import the packages
        we vendor, our components included. Nothing runs in this page.
      </p>

      <div class="panes">
        <section class="editor-pane">
          <div id="modes" role="tablist" aria-label="Mode"></div>
          <div id="tabs" role="tablist" aria-label="Demo files"></div>
          <playground-code-editor id="demo" line-numbers aria-label="Selected demo file"></playground-code-editor>
        </section>
        <section class="run-pane">
          <h2>preview</h2>
          <div id="fence" class="preview"></div>
          <button id="run" type="button">Run</button>
          <p id="status" class="status" role="status">Not run yet.</p>
          <h3>content check</h3>
          <p id="content-check" class="status"></p>
          <ul id="findings" aria-label="Content check findings"></ul>
          <div id="node-panes">
            <h3>output</h3>
            <pre id="output" aria-label="Program output"></pre>
            <h3>files</h3>
            <ul id="files" aria-label="Resulting files"></ul>
          </div>
          <h3>packages you can import</h3>
          <ul id="packages" aria-label="Importable packages"></ul>
          <p class="note" id="mode-note"></p>
        </section>
      </div>
    </main>

    <script>
      // The same editor the playground uses, on its own: the element imports Lit and CodeMirror and nothing
      // else, so it works here — the *preview* of playground-elements cannot, because it is a
      // PlaygroundConnectedElement that draws a project's service-worker-backed filesystem, and an opaque
      // origin has the service worker api disabled.
      import 'playground-elements/playground-code-editor.js';

      const _base = import.meta.env.BASE_URL;
      const base = _base.endsWith('/') ? _base : `${_base}/`;
      // The runner's files are shipped as static assets (see the portal's predev/prebuild), next to the
      // generated import map, so they are addressed as files and not through the client bundle.
      const assetsBase = `${base}lion-playground-node-demo/`;
      // Absolute, because `new URL(relative, base)` needs an absolute base: the shim urls are derived from the
      // engine's own directory so that the engine and a demo reach the *same* shim module.
      const engineUrl = new URL(`${assetsBase}engine.js`, location.href).href;

      const editor = document.querySelector('#demo');
      const editorTypeFor = name =>
        name.endsWith('.html') ? 'html' : name.endsWith('.css') ? 'css' : name.endsWith('.json') ? 'json' : 'js';
      const modeTabs = document.querySelector('#modes');
      const tabs = document.querySelector('#tabs');
      const runButton = document.querySelector('#run');
      const status = document.querySelector('#status');
      const contentCheck = document.querySelector('#content-check');
      const findingsList = document.querySelector('#findings');
      const output = document.querySelector('#output');
      const nodePanes = document.querySelector('#node-panes');
      const filesList = document.querySelector('#files');
      const packagesList = document.querySelector('#packages');
      const modeNote = document.querySelector('#mode-note');
      const fence = document.querySelector('#fence');

      const modes = {
        browser: {
          note: 'Browser mode: index.html is the document and main.js is its module. There is no filesystem to write to — the demo is the page.',
          files: {
            'index.html': `<h1>A Lion component, in browser mode</h1>
<lion-input label="Your name"></lion-input>
<lion-button>Save</lion-button>
`,
            'main.js': `import '@lion/ui/define/lion-input.js';
import '@lion/ui/define/lion-button.js';

const button = document.querySelector('lion-button');
button.addEventListener('click', () => {
  button.textContent = 'Saved';
});
`,
          },
        },
        node: {
          note: 'Node mode: the entry runs against the shim layer, so it reads and writes files and reports output. A builtin the layer does not answer — module, child_process, http — fails with “Failed to resolve module specifier”.',
          files: {
            'demo.js': `import '@lion/ui/define/lion-button.js';
import '@lion/ui/define/lion-input.js';
import { readFileSync, writeFileSync, readdirSync } from 'fs';
import { basename } from 'path';

const data = JSON.parse(readFileSync('/data.json', 'utf8'));

document.body.innerHTML = [
  '<h1>' + data.title + '</h1>',
  '<lion-input label="' + data.field + '"></lion-input>',
  '<lion-button>' + data.action + '</lion-button>',
].join('');

await customElements.whenDefined('lion-button');
await customElements.whenDefined('lion-input');
await document.querySelector('lion-input').updateComplete;

writeFileSync('/out.txt', data.action.toUpperCase());
console.log('components registered:', ['lion-button', 'lion-input'].every(t => customElements.get(t)));
console.log('wrote', basename('/out.txt'), '->', readFileSync('/out.txt', 'utf8'));
console.log('files here:', readdirSync('/').join(', '));
`,
            'styles.css': `body {
  font-family: system-ui, sans-serif;
  padding: 1rem;
}
h1 {
  font-size: 1rem;
  margin: 0 0 0.75rem;
}
lion-input, lion-button {
  display: block;
  margin-bottom: 0.5rem;
}
`,
            'data.json': `{
  "title": "A Lion component, rendered inside the fence",
  "field": "Your name",
  "action": "Save"
}
`,
          },
        },
      };

      let mode = 'browser';
      let activeFile = null;
      const filesOf = name => modes[name].files;

      const renderTabs = () => {
        tabs.textContent = '';
        for (const name of Object.keys(filesOf(mode))) {
          const tab = document.createElement('button');
          tab.type = 'button';
          tab.setAttribute('role', 'tab');
          tab.dataset.file = name;
          tab.textContent = name;
          tab.setAttribute('aria-selected', String(name === activeFile));
          tab.addEventListener('click', () => selectFile(name));
          tabs.appendChild(tab);
        }
      };

      const selectFile = name => {
        // Only save what was actually being edited: on the first selection there is nothing to save, and
        // writing the empty editor back would erase the file that was preloaded.
        if (activeFile) filesOf(mode)[activeFile] = editor.value;
        activeFile = name;
        editor.type = editorTypeFor(name);
        editor.value = filesOf(mode)[name];
        for (const tab of tabs.querySelectorAll('[role="tab"]')) {
          tab.setAttribute('aria-selected', String(tab.dataset.file === name));
        }
      };

      const selectMode = name => {
        if (activeFile) filesOf(mode)[activeFile] = editor.value;
        mode = name;
        activeFile = null;
        for (const tab of modeTabs.querySelectorAll('[role="tab"]')) {
          tab.setAttribute('aria-selected', String(tab.dataset.mode === name));
        }
        modeNote.textContent = modes[name].note;
        // Node mode reports output and a file tree; browser mode is the document itself, so those panes have
        // nothing to show and would only be misleading.
        nodePanes.hidden = name !== 'node';
        status.textContent = 'Not run yet.';
        fence.textContent = '';
        renderTabs();
        selectFile(Object.keys(filesOf(mode))[0]);
      };

      for (const name of Object.keys(modes)) {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.setAttribute('role', 'tab');
        tab.dataset.mode = name;
        tab.textContent = name === 'browser' ? 'browser (html + js)' : 'node (modules + fs)';
        tab.addEventListener('click', () => selectMode(name));
        modeTabs.appendChild(tab);
      }

      const load = specifier => import(/* @vite-ignore */ specifier);
      let assets = null;
      const loadAssets = async () => {
        if (!assets) {
          const [importMapPerPackage, packageMains, host, shareDemo] = await Promise.all([
            load(`${assetsBase}importMapPerPackage.js`).then(module => module.default),
            load(`${assetsBase}packageMains.js`).then(module => module.default),
            load(`${assetsBase}host.js`),
            load(`${assetsBase}shareDemo.js`),
          ]);
          assets = { importMapPerPackage, packageMains, host, shareDemo };
        }
        return assets;
      };

      runButton.addEventListener('click', async () => {
        runButton.disabled = true;
        status.textContent = 'Running…';
        output.textContent = '';
        filesList.textContent = '';
        // A fresh fence per run: in node mode the engine resets its own filesystem, and the frame is one
        // document per run anyway, which keeps a failed run from leaving anything behind.
        fence.textContent = '';
        if (activeFile) filesOf(mode)[activeFile] = editor.value;

        try {
          const { importMapPerPackage, packageMains, host, shareDemo } = await loadAssets();
          const { checkDemoContent, describeContentReport } = await load(`${assetsBase}checkDemoContent.js`);

          // What the content does, before it runs. In the fenced postures this is information; in a
          // same-origin deployment (no second host available) it is the mitigation, because there nothing but
          // the worker's policy and this review stands between a demo and this origin's cookies and storage.
          const contentReport = checkDemoContent(filesOf(mode));
          contentCheck.textContent = describeContentReport(contentReport);
          findingsList.textContent = '';
          for (const finding of contentReport.findings) {
            const item = document.createElement('li');
            item.textContent = `${finding.file}:${finding.line} ${finding.rule} (${finding.severity})`;
            findingsList.appendChild(item);
          }
          if (!packagesList.childElementCount) {
            for (const name of Object.keys(importMapPerPackage)) {
              const item = document.createElement('li');
              item.textContent = name;
              packagesList.appendChild(item);
            }
          }

          if (mode === 'browser') {
            const iframe = document.createElement('iframe');
            iframe.setAttribute('sandbox', 'allow-scripts');
            iframe.setAttribute('title', 'Demo preview');
            iframe.srcdoc = shareDemo.buildFencedDocument(
              {
                entry: 'main.js',
                htmlFile: 'index.html',
                files: Object.fromEntries(
                  Object.entries(filesOf('browser')).map(([name, content]) => [
                    name,
                    { content, contentType: name.endsWith('.html') ? 'text/html' : 'text/javascript' },
                  ]),
                ),
              },
              {
                importMap: host.buildFenceImportMap(
                  { importMapPerPackage, packageMains },
                  location.origin,
                  new URL('./shims', engineUrl).href,
                ),
                assetsOrigin: location.origin,
              },
            );
            fence.appendChild(iframe);
            status.textContent = 'Rendered as the document.';
          } else {
            const report = await host.runDemoInFence({
              container: fence,
              payload: {
                entry: '/demo.js',
                files: {
                  ...Object.fromEntries(
                    Object.entries(filesOf('node')).map(([name, content]) => [`/${name}`, { content }]),
                  ),
                  '/input.txt': { content: 'hello from the demo' },
                },
              },
              importMapPerPackage,
              packageMains,
              assetsOrigin: location.origin,
              engineUrl,
              styles: filesOf('node')['styles.css'],
            });

            for (const entry of report.log) {
              output.textContent += entry.stream === 'stderr' ? `! ${entry.text}` : entry.text;
            }
            for (const [pathname, content] of Object.entries(report.files)) {
              const item = document.createElement('li');
              item.textContent = `${pathname} (${content.length} chars)`;
              filesList.appendChild(item);
            }
            status.textContent = `Finished with exit code ${report.exitCode}.`;
          }
        } catch (error) {
          status.textContent = `Could not run: ${error && error.message ? error.message : error}`;
        } finally {
          runButton.disabled = false;
        }
      });

      selectMode('browser');
    </script>

    <style>
      main {
        margin: 0 auto;
        max-width: 68rem;
        padding: 2rem 1.25rem 4rem;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }
      h1 { font-size: 1.6rem; margin: 0 0 0.5rem; }
      .lede { color: #444; max-width: 64ch; }
      .panes { display: grid; gap: 1.5rem; grid-template-columns: 1fr 1fr; align-items: start; }
      @media (max-width: 52rem) { .panes { grid-template-columns: 1fr; } }
      h2 { font-size: 1rem; margin: 0 0 0.4rem; }
      h3 { font-size: 0.9rem; margin: 1rem 0 0.3rem; }
      #modes { display: flex; gap: 0.25rem; flex-wrap: wrap; margin-bottom: 0.75rem; }
      #modes [role='tab'] {
        font: inherit; font-size: 0.9rem; padding: 0.35rem 0.9rem; cursor: pointer;
        border: 1px solid #888; border-radius: 999px; background: #fff;
      }
      #modes [role='tab'][aria-selected='true'] { background: #2f2e41; color: #fff; border-color: #2f2e41; }
      /* The file tabs, the way a playground presents a demo's files. */
      #tabs { display: flex; gap: 0.25rem; flex-wrap: wrap; margin-bottom: 0.4rem; }
      #tabs [role='tab'] {
        font: inherit; font-size: 0.85rem; padding: 0.25rem 0.7rem; cursor: pointer;
        border: 1px solid #ccc; border-bottom: none; border-radius: 6px 6px 0 0; background: #f4f4f4;
      }
      #tabs [role='tab'][aria-selected='true'] { background: #fff; border-color: #888; font-weight: 600; }
      /* The editor is playground-elements' own code editor: CodeMirror with syntax highlighting and line
         numbers, the same one the playground uses. */
      #demo {
        display: block; min-height: 22rem; border: 1px solid #888; border-radius: 0 6px 6px 6px; overflow: hidden;
      }
      /* The frame itself: a demo renders inside it, so this is the preview. */
      .preview {
        height: 14rem; border: 1px solid #ccc; border-radius: 6px; background: #fff; overflow: hidden;
      }
      .preview iframe { display: block; width: 100%; height: 100%; border: 0; }
      pre, ul { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.82rem; }
      pre { margin: 0; min-height: 3rem; white-space: pre-wrap; }
      ul { margin: 0; padding-left: 1.1rem; }
      button { font: inherit; padding: 0.4rem 1rem; border-radius: 6px; border: 1px solid #888; background: #fff; cursor: pointer; }
      #run { margin-top: 0.75rem; }
      button[disabled] { opacity: 0.6; cursor: progress; }
      .status { margin: 0.6rem 0 0; font-size: 0.9rem; }
      .note { color: #555; font-size: 0.85rem; max-width: 64ch; }
      [hidden] { display: none !important; }
    </style>
  </body>
</html>

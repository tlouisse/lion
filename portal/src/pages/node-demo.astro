---
// One mechanism: the playground's service worker. This page hosts `playground-ide`, so the editor, the file
// tabs, the preview and the worker are all the playground's own — and the sandbox url is the deployment's, not
// this page's: `PLAYGROUND_SANDBOX_BASE_URL` points it at a second origin where one exists (the upstream
// design, and the boundary), and only a deployment that explicitly opts in runs it on this origin
// (`PUBLIC_SAME_ORIGIN_SANDBOX`), where the worker sets a policy on the documents it serves and the content
// check below is the mitigation.
//
// Three modes, all served by that worker, named for where the code runs — the split a developer already has:
//  - `client`: `client/index.html` is the document, `client/main.js` its module — the playground's own model.
//  - `server`: a hidden harness (`index.html` + `boot.js`) imports `server/main.js` by its served url and runs it
//    against the dependency-free Node layer (fs, path, process, os, util, events, url, worker_threads), with the
//    project's own files as its filesystem. Reading them from the served project is what makes an edit re-run.
//  - `ssr`: the same harness runs `server/render.js`, puts its response in the document, and `client/hydrate.js`
//    takes over. Before anything runs, client/ is checked for imports a browser cannot have (Node builtins, server/).
import TopNav from '../components/TopNav.astro';
import ThemeInit from '../components/ThemeInit.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const sandboxBaseUrl =
  process.env.PLAYGROUND_SANDBOX_BASE_URL || `${base}lion-playground/playground-elements`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <ThemeInit />
    <title>Demo — Lion</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}styles/theme.css`} />
    <link rel="stylesheet" href={`${base}styles/styles.css`} />
    {/* CodeSandbox's interface, measured, runs on Inter and draws its UI icons from Material Symbols Outlined —
        so this page loads the same two, and the icons are the same glyphs rather than lookalikes. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400..600,0..1,0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <TopNav />
    <main>
      <header>
        <p class="lede">
          One project, split the way an app is: <code>client/</code> runs in the browser, <code>server/</code> runs
          on the server. <strong>client</strong> renders a page; <strong>server</strong> reads and writes files,
          prints to stdout and starts a worker thread; <strong>ssr</strong> is both halves — the server renders the
          markup and the client takes it over. There is no real server: the playground's service worker serves the
          files, and <code>server/</code> runs in this browser against a dependency-free Node layer
          (<code>fs</code>, <code>path</code>, <code>process</code>, <code>worker_threads</code>, …) — no
          WebContainer, no second runtime.
        </p>
      </header>

      <div class="toolbar playground-app">
        <div id="modes" role="tablist" aria-label="Mode"></div>
        <!-- Dark mode is the portal's own: the theme switch lives in the site header (TopNav) and ThemeInit keeps
             `data-theme` on <html> and the stored choice in sync, which is what the dark rules below follow. -->
      </div>

      <div class="playground playground-app">
        <!-- The view rail: the icons switch what the desktop shows, the way an activity bar does — one view model,
             driven from one attribute. A phone has no rail: its bar at the bottom drives the accordion instead. -->
        <nav class="view-rail" aria-label="Views">
          <button type="button" data-view="files" class="is-active" title="Files" aria-label="Files">
            <span class="material-symbols-outlined" aria-hidden="true">folder</span>
          </button>
          <button type="button" data-view="code" title="Code" aria-label="Code">
            <span class="material-symbols-outlined" aria-hidden="true">code</span>
          </button>
          <button type="button" data-view="preview" title="Preview" aria-label="Preview">
            <span class="material-symbols-outlined" aria-hidden="true">smartphone</span>
          </button>
          <button type="button" data-view="output" title="Output" aria-label="Output">
            <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
          </button>
        </nav>
        <!-- The four parts — project, code, preview, output — are native disclosures. On a phone they are the
             accordion the bottom bar drives: each is independent, so several may be open at once, and the bar shows
             the one in view rather than "the open one". Above the breakpoint they are `display: contents` with their
             summaries hidden, so the two columns lay out exactly as they do without them. They wrap the content where
             it already is: the editor cannot be moved to another parent without CodeMirror re-initialising.
             `<details>`, not lion-accordion: see the checks. -->
        <section class="pane" id="pane-project">
          <h2>project</h2>
          <details class="part" id="part-files" data-part="files" open>
            <summary class="part-head">
              <span class="material-symbols-outlined" aria-hidden="true">folder</span>project
            </summary>
            <demo-tree id="file-tree"></demo-tree>
          </details>
          <details class="part" id="part-code" data-part="code" open>
            <summary class="part-head">
              <span class="material-symbols-outlined" aria-hidden="true">code</span>code
            </summary>
            <div class="tab-scroller">
              <lion-tabs id="open-files"></lion-tabs>
            </div>
            <playground-project id="project" sandbox-base-url={sandboxBaseUrl}></playground-project>
            <playground-file-editor id="editor"></playground-file-editor>
          </details>
        </section>

        <section class="pane" id="pane-run">
          <h2>run</h2>
          <details class="part" id="part-preview" data-part="preview" open>
            <summary class="part-head">
              <span class="material-symbols-outlined" aria-hidden="true">smartphone</span>preview
            </summary>
            <p id="status" class="status" role="status">Not run yet.</p>
            <playground-preview id="preview"></playground-preview>
            <!-- A server has no page. In server mode the preview still runs the harness — it is where the server code
                 executes — but it shows nothing worth looking at, so this says where the result is instead. -->
            <div id="no-page" class="no-page">
              <span class="material-symbols-outlined" aria-hidden="true">dns</span>
              <p>A server has no page. What it did is in the console: its stdout, the files it wrote and its worker.</p>
            </div>
            <div id="busy" hidden><lion-progress-indicator indeterminate label="Running"></lion-progress-indicator></div>
          </details>
          <details class="part" id="part-output" data-part="output" open>
            <summary class="part-head">
              <span class="material-symbols-outlined" aria-hidden="true">terminal</span>output
            </summary>
          <div id="node-panes">
            <pre id="output" class="terminal" aria-label="Program output"></pre>
            <ul id="files" aria-label="Files the run wrote"></ul>
          </div>
          <!-- Lion's accordion cannot be themed: measured no `--lion-*` tokens, no `::part` and no `:host`
               background in the component, so it paints its own light chrome on a dark surface. A native
               `<details>` is a disclosure this page owns and can style; the Lion components stay where they can
               carry the look — the tree (the menu system), the tabs, the busy indicator. -->
          <details class="checks">
            <summary>checks</summary>
            <p id="content-check" class="status"></p>
            <ul id="findings" aria-label="Content check findings"></ul>
            <p id="boundary" class="status" aria-label="Client/server boundary"></p>
            <p id="governance" class="status" aria-label="Governance check"></p>
            <h3>packages you can import</h3>
            <ul id="packages" aria-label="Importable packages"></ul>
            <p class="note">
              A builtin the layer does not answer — <code>module</code>, <code>child_process</code>,
              <code>http</code> — fails with <em>Failed to resolve module specifier</em>. That is the honest
              boundary, not a bug: those need a real runtime.
            </p>
          </details>
          <p class="note" id="mode-note"></p>
          </details>
        </section>
      </div>

      <!-- The phone's bar: it drives the accordion above — a tap opens that part and scrolls it into view — and it
           shows which part is open. The icons are Material Symbols Outlined over Inter, the same set as the rail. -->
      <nav class="mobile-tabs" aria-label="View">
        <button type="button" data-view="files">
          <span class="material-symbols-outlined" aria-hidden="true">folder</span>
          <span>Project</span>
        </button>
        <button type="button" data-view="code" class="is-active">
          <span class="material-symbols-outlined" aria-hidden="true">code</span>
          <span>Code</span>
        </button>
        <button type="button" data-view="preview">
          <span class="material-symbols-outlined" aria-hidden="true">smartphone</span>
          <span>Preview</span>
        </button>
        <button type="button" data-view="output">
          <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
          <span>Output</span>
        </button>
      </nav>
    </main>

    <script>
      import 'playground-elements/playground-project.js';
      import 'playground-elements/playground-file-editor.js';
      import 'playground-elements/playground-preview.js';
      // The file tree is Lion's own. `LionTree` was removed from the package and survives as
      // `docs/components/menu/src/DemoTree.js` — a `MultiLevelListMixin` host with `role="tree"` — which is the
      // configuration the menu system's own docs and migration guide point at.
      import { DemoTree } from '../../../docs/components/menu/src/DemoTree.js';
      // The chrome is Lion's where it can carry the look: the tree is the menu system, the tabs are Lion's, the busy
      // state is Lion's progress indicator. The accordion is not here — it has no theming surface (see the markup
      // comment). Dark mode is the portal header's, not this page's: see ThemeInit and TopNav.
      import '@lion/ui/define/lion-progress-indicator.js';

      void DemoTree;

      const _base = import.meta.env.BASE_URL;
      const base = _base.endsWith('/') ? _base : `${_base}/`;
      const assetsBase = `${base}lion-playground-node-demo/`;
      // Absolute: the shim urls are derived from the engine's own directory, so that the engine and a demo
      // reach the *same* shim module. A shim reached by two urls is two module instances with two filesystems.
      const engineUrl = new URL(`${assetsBase}engine.js`, location.href).href;
      // The posture is configured, never inferred: false means the sandbox has its own origin (the browser is
      // the boundary), true is the explicit opt-in that makes the worker set a policy and the check a gate.
      const sameOriginSandbox = import.meta.env.PUBLIC_SAME_ORIGIN_SANDBOX === 'true';

      // Not `<playground-ide>`: the ide is just these three elements side by side, and composing them ourselves is
      // what makes the editor tabs ours. The ide keeps the file editor, the preview and the tab bar in its own
      // shadow root, and it has no public way to select a file — the tab bar sets `editor.filename` directly —
      // whereas `project.config` is exactly the shape this page already builds.
      const project = document.querySelector('#project');
      const editor = document.querySelector('#editor');
      const preview = document.querySelector('#preview');
      editor.project = project;
      preview.project = project;
      preview.htmlFile = 'index.html';
      const modeTabs = document.querySelector('#modes');
      const status = document.querySelector('#status');
      const contentCheck = document.querySelector('#content-check');
      const findingsList = document.querySelector('#findings');
      const output = document.querySelector('#output');
      const nodePanes = document.querySelector('#node-panes');
      const filesList = document.querySelector('#files');
      const packagesList = document.querySelector('#packages');
      const modeNote = document.querySelector('#mode-note');
      const governance = document.querySelector('#governance');
      const busy = document.querySelector('#busy');
      let fileTree = document.querySelector('#file-tree');

      // A tree in Lion today is markup, not a component API: a `demo-tree` holds `role="treeitem"` items and, for
      // a folder, another `demo-tree` beside the item — the menu system's `MultiLevelListMixin` contract.
      //
      // The mixin reads its items when it upgrades, so filling an existing tree afterwards leaves it inert
      // (measured: the element defined, `aria-level`/`aria-posinset`/`aria-setsize` never set, no `role="tree"`).
      // A fresh host with its children already in place is the condition the docs' static markup has, so that is
      // what this builds — and the items are the project's flat file list turned into that nesting.
      // File-type icons come from the same Material Symbols set the mobile bar uses, so the tree and the tabs read
      // at a glance the way an editor's do.
      const iconForFile = name => {
        if (name.endsWith('.html')) return 'html';
        if (name.endsWith('.js') || name.endsWith('.mjs')) return 'javascript';
        if (name.endsWith('.json')) return 'data_object';
        if (name.endsWith('.css')) return 'css';
        if (name.endsWith('.md')) return 'description';
        return 'draft';
      };

      const withIcon = (element, iconName) => {
        const icon = document.createElement('span');
        icon.className = 'material-symbols-outlined';
        icon.setAttribute('aria-hidden', 'true');
        icon.textContent = iconName;
        element.prepend(icon);
      };

      // The tree is the app's split: its top-level folders are `client/` and `server/`, and each says where it runs,
      // so the tree itself shows which code runs where. It reads as structure — folders, indented children, a
      // disclosure — and not as a second row of tabs. Lion's menu system makes a folder row the invoker of the group
      // after it but does not open or close it here (its disclosure wiring is not in this mixin), so the page owns
      // that: `aria-expanded` on the row, `hidden` on the group.
      const sides = { client: ['web', 'in the browser'], server: ['dns', 'on the server'] };
      const renderTree = (mount, files) => {
        const root = { children: new Map() };
        for (const name of Object.keys(files)) {
          const parts = name.split('/');
          let node = root;
          parts.forEach((part, index) => {
            if (!node.children.has(part)) node.children.set(part, { children: new Map() });
            node = node.children.get(part);
            if (index === parts.length - 1) node.file = name;
          });
        }
        const next = document.createElement('demo-tree');
        next.id = mount.id;
        const treeItem = (parent, name, iconName) => {
          const item = document.createElement('div');
          item.setAttribute('role', 'treeitem');
          const label = document.createElement('span');
          label.textContent = name;
          item.append(label);
          withIcon(item, iconName);
          parent.appendChild(item);
          return item;
        };
        const folder = (parent, name, node, depth) => {
          const side = depth === 0 ? sides[name] : undefined;
          const item = treeItem(parent, name, side ? side[0] : 'folder_open');
          item.dataset.folder = '';
          item.setAttribute('aria-expanded', 'true');
          if (side) {
            item.dataset.side = name;
            const hint = document.createElement('span');
            hint.className = 'tree-hint';
            hint.textContent = side[1];
            item.append(hint);
          }
          const group = document.createElement('demo-tree');
          append(group, node, depth + 1);
          parent.appendChild(group);
          item.addEventListener('click', () => {
            const open = item.getAttribute('aria-expanded') !== 'true';
            item.setAttribute('aria-expanded', String(open));
            if (!side) item.querySelector('.material-symbols-outlined').textContent = open ? 'folder_open' : 'folder';
            group.hidden = !open;
          });
        };
        function append(parent, node, depth) {
          for (const [part, child] of node.children) {
            if (child.file) {
              const item = treeItem(parent, part, iconForFile(part));
              item.dataset.file = child.file;
              item.addEventListener('click', () => {
                openFile(child.file);
              });
            } else if (child.children.size) {
              folder(parent, part, child, depth);
            }
          }
        }
        append(next, root, 0);
        mount.replaceWith(next);
        return next;
      };

      // Editor tabs, à la StackBlitz: the open files are the user's list, not the filesystem's order — closing a tab
      // does not delete a file, and the order is the user's to change. Lion's tabs own `role="tab"`, the roving
      // tabindex and the aria wiring; a tab element is a plain div here so the close button can legitimately live
      // inside it. Lion pairs every tab with a panel (it asserts equal counts), so each tab gets an empty one and the
      // editor is the real panel — it cannot be re-parented into a Lion panel without re-initialising CodeMirror.
      const openFilesBar = document.querySelector('#open-files');
      const tabScroller = openFilesBar.parentElement;
      // A strip that scrolls says so with a fade at the edge it scrolls towards, so a cut-off tab reads as "more this
      // way" rather than as a rendering bug. Measured on every render, resize and scroll, because only the layout
      // knows whether the tabs fit.
      const updateTabOverflow = () => {
        const overflowing = tabScroller.scrollWidth > tabScroller.clientWidth + 1;
        tabScroller.classList.toggle('is-overflowing', overflowing);
        tabScroller.classList.toggle(
          'is-at-end',
          tabScroller.scrollLeft + tabScroller.clientWidth >= tabScroller.scrollWidth - 1,
        );
      };
      tabScroller.addEventListener('scroll', updateTabOverflow, { passive: true });
      new ResizeObserver(updateTabOverflow).observe(tabScroller);
      let openFiles = [];
      let activeFile = null;
      let draggedFile = null;

      const renderOpenFiles = () => {
        openFilesBar.textContent = '';
        openFiles.forEach(name => {
          const tab = document.createElement('div');
          tab.slot = 'tab';
          tab.draggable = true;
          tab.dataset.file = name;
          // A tab names the file; the tree already shows where it lives, and the full path is the tooltip. Two open
          // files with the same name show their paths, so the strip never shows two identical labels.
          const label = document.createElement('span');
          const fileName = name.split('/').pop();
          const clash = openFiles.some(other => other !== name && other.split('/').pop() === fileName);
          label.textContent = clash ? name : fileName;
          tab.title = name;
          const close = document.createElement('button');
          close.type = 'button';
          close.className = 'close';
          close.setAttribute('aria-label', `Close ${name}`);
          withIcon(close, 'close');
          close.addEventListener('click', event => {
            event.stopPropagation();
            closeOpenFile(name);
          });
          tab.append(label, close);
          withIcon(tab, iconForFile(name));
          tab.addEventListener('dragstart', event => {
            draggedFile = name;
            tab.classList.add('dragging');
            event.dataTransfer?.setData('text/plain', name);
          });
          tab.addEventListener('dragend', () => {
            tab.classList.remove('dragging');
            draggedFile = null;
            commitTabOrder();
          });
          // A drag that shows the result while it happens: the tab follows the pointer, and the *DOM node* moves
          // rather than the list re-rendering — replacing the dragged element mid-drag cancels the drag itself.
          tab.addEventListener('dragover', event => {
            if (!draggedFile || draggedFile === name) return;
            event.preventDefault();
            const dragged = openFilesBar.querySelector(
              `[slot="tab"][data-file="${CSS.escape(draggedFile)}"]`,
            );
            if (!dragged || dragged === tab) return;
            const rect = tab.getBoundingClientRect();
            const afterPointer = event.clientX > rect.left + rect.width / 2;
            openFilesBar.insertBefore(dragged, afterPointer ? tab.nextSibling : tab);
            if (dragged.__panel) openFilesBar.insertBefore(dragged.__panel, dragged.nextSibling);
          });
          tab.addEventListener('drop', event => {
            event.preventDefault();
            commitTabOrder();
          });
          openFilesBar.appendChild(tab);
          // Lion decorates its slotted tabs (`role="tab"`, `aria-controls` and the key handlers) from a
          // `slotchange` listener, but measured it does not for tabs added after it upgraded: role stayed null and
          // tabindex -1. So the page completes what Lion's own `setupButton` would have set rather than shipping a
          // tablist without tab semantics — the roving tabindex is the ARIA APG one, 0 on the selected tab.
          if (!tab.getAttribute('role')) tab.setAttribute('role', 'tab');
          tab.setAttribute('aria-selected', String(name === activeFile));
          tab.tabIndex = name === activeFile ? 0 : -1;
          if (!tab.hasAttribute('aria-controls')) tab.setAttribute('aria-controls', 'editor');
          const panel = document.createElement('div');
          panel.slot = 'panel';
          panel.hidden = true;
          panel.setAttribute('aria-hidden', 'true');
          // The panel that Lion requires per tab travels with its tab, so a live reorder cannot separate the pair.
          tab.__panel = panel;
          openFilesBar.appendChild(panel);
        });
        openFilesBar.selectedIndex = Math.max(0, openFiles.indexOf(activeFile));
        requestAnimationFrame(updateTabOverflow);
        // The tree marks the open file as well, so the two never disagree about what is being edited.
        for (const item of fileTree.querySelectorAll('[role="treeitem"][data-file]')) {
          if (item.dataset.file === activeFile) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        }
      };

      const openFile = name => {
        if (!openFiles.includes(name)) openFiles = [...openFiles, name];
        activeFile = name;
        editor.filename = name;
        renderOpenFiles();
      };

      const closeOpenFile = name => {
        const index = openFiles.indexOf(name);
        openFiles = openFiles.filter(file => file !== name);
        if (activeFile === name) {
          // Closing the active tab activates its neighbour rather than nothing, which is what an editor does.
          activeFile = openFiles[Math.min(index, openFiles.length - 1)] ?? null;
          if (activeFile) editor.filename = activeFile;
        }
        renderOpenFiles();
      };

      /**
       * The order the user dragged is the DOM order, so it is read back from there rather than reconstructed from
       * indices — a live drag moves nodes, and only the DOM knows what the user ended up looking at.
       */
      const commitTabOrder = () => {
        const order = [...openFilesBar.querySelectorAll('[slot="tab"]')].map(tab => tab.dataset.file);
        if (order.length === openFiles.length) openFiles = order;
        draggedFile = null;
        renderOpenFiles();
      };

      const moveOpenFile = (name, beforeName) => {
        if (!name || name === beforeName) return;
        const next = openFiles.filter(file => file !== name);
        next.splice(next.indexOf(beforeName), 0, name);
        openFiles = next;
        renderOpenFiles();
      };

      const reorderOpenFile = (name, delta) => {
        const from = openFiles.indexOf(name);
        const to = from + delta;
        if (to < 0 || to >= openFiles.length) return;
        openFiles = openFiles.map((file, index) =>
          index === from ? openFiles[to] : index === to ? openFiles[from] : file,
        );
        renderOpenFiles();
      };

      openFilesBar.addEventListener('click', event => {
        const tab = event.target.closest('[slot="tab"]');
        if (tab?.dataset.file) openFile(tab.dataset.file);
      });
      // Dragging is not accessible on its own, so the same move has a keyboard form. It is bound on the document
      // because a tab div is not reliably focusable — Lion manages the roving tabindex itself — and it acts on the
      // selected tab. Events from inside the editor are left alone: CodeMirror has its own use for Alt+arrows.
      document.addEventListener('keydown', event => {
        if (!event.altKey || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
        if (event.target instanceof Element && event.target.closest('#editor')) return;
        if (!activeFile) return;
        event.preventDefault();
        reorderOpenFile(activeFile, event.key === 'ArrowLeft' ? -1 : 1);
      });

      // The theme is the portal's, not this page's: the header's radio group drives `data-theme` on <html> through
      // `public/styles/theme.css` and ThemeInit keeps the stored choice in sync, so there is nothing to wire here.
      // The page's dark rules below simply follow that attribute.

      /**
       * The client/server boundary, checked the way a bundler checks it: statically, from the import specifiers of
       * every `client/` file, before anything runs. A client file may not import a Node builtin (`fs`, `path`,
       * `process`, `node:*`, …) — a browser has none — and may not import from `server/`, which is never sent to a
       * browser. A server file may import anything, including client code it renders.
       *
       * What it does not catch, said plainly: a specifier computed at run time (`import(name)`). Nor does a bundler.
       *
       * Self-contained on purpose — no outside names — because its source is also embedded in the harness (see
       * `bootSourceFor`), so the page and the run enforce the same rule from one definition.
       *
       * `shimBase` is for the harness: it reads the files as the playground *serves* them, and the playground has
       * already rewritten bare specifiers through the import map — measured: `node:process` arrives as the shim's
       * url. A specifier inside the shim directory is therefore a builtin under another name, and is reported by
       * the builtin's name.
       * @param {{[name: string]: string}} files
       * @param {string} [shimBase] the url the shims are served from
       * @returns {{file: string, line: number, specifier: string, message: string}[]}
       */
      function checkBoundary(files, shimBase) {
        const builtins = new Set(
          ('assert async_hooks buffer child_process cluster console crypto dgram diagnostics_channel dns events fs ' +
            'http http2 https inspector module net os path perf_hooks process querystring readline repl stream ' +
            'string_decoder timers tls tty url util v8 vm worker_threads zlib').split(' '),
        );
        const violations = [];
        for (const [file, content] of Object.entries(files)) {

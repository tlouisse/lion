---
// One mechanism: the playground's service worker. This page hosts `playground-ide`, so the editor, the file
// tabs, the preview and the worker are all the playground's own — and the sandbox url is the deployment's, not
// this page's: `PLAYGROUND_SANDBOX_BASE_URL` points it at a second origin where one exists (the upstream
// design, and the boundary), and only a deployment that explicitly opts in runs it on this origin
// (`PUBLIC_SAME_ORIGIN_SANDBOX`), where the worker sets a policy on the documents it serves and the content
// check below is the mitigation.
//
// Two modes, both served by that worker:
//  - `browser`: index.html is the document, main.js its module — the playground's own model.
//  - `node`: index.html boots `boot.js`, which reads the project's own files and hands them to the
//    dependency-free Node layer (fs, path, process, os, util, events, url). Reading the files from the served
//    filesystem is what makes an edit in the editor re-run with the new content.
import TopNav from '../components/TopNav.astro';
import ThemeInit from '../components/ThemeInit.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const sandboxBaseUrl =
  process.env.PLAYGROUND_SANDBOX_BASE_URL || `${base}lion-playground/playground-elements`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <ThemeInit />
    <title>Demo — Lion</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}styles/theme.css`} />
    <link rel="stylesheet" href={`${base}styles/styles.css`} />
    {/* CodeSandbox's interface, measured, runs on Inter and draws its UI icons from Material Symbols Outlined —
        so this page loads the same two, and the icons are the same glyphs rather than lookalikes. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400..600,0..1,0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <TopNav />
    <main>
      <header>
        <h1>Lion playground</h1>
        <p class="lede">
          Three modes, one mechanism: the playground's service worker serves this project — no WebContainer, no
          second runtime. <strong>browser</strong> renders <code>index.html</code> with <code>main.js</code>;
          <strong>node</strong> runs the project's own files through a dependency-free Node layer
          (<code>fs</code>, <code>path</code>, <code>process</code>, <code>os</code>, <code>util</code>,
          <code>events</code>, <code>url</code>); <strong>ssr</strong> renders a component to a string with
          <code>@lit-labs/ssr</code> and then hydrates it.
        </p>
      </header>

      <div class="toolbar playground-app">
        <div id="modes" role="tablist" aria-label="Mode"></div>
        <!-- Dark mode is the portal's own: the theme switch lives in the site header (TopNav) and ThemeInit keeps
             `data-theme` on <html> and the stored choice in sync, which is what the dark rules below follow. -->
      </div>

      <div class="playground playground-app">
        <!-- The view rail: the icons switch what the app shows, the way an activity bar does. One view model, driven
             from one attribute — the phone gets the same model as a bar at the bottom instead. -->
        <nav class="view-rail" aria-label="Views">
          <button type="button" data-view="files" class="is-active" title="Files" aria-label="Files">
            <span class="material-symbols-outlined" aria-hidden="true">folder</span>
          </button>
          <button type="button" data-view="code" title="Code" aria-label="Code">
            <span class="material-symbols-outlined" aria-hidden="true">code</span>
          </button>
          <button type="button" data-view="preview" title="Preview" aria-label="Preview">
            <span class="material-symbols-outlined" aria-hidden="true">smartphone</span>
          </button>
          <button type="button" data-view="output" title="Output" aria-label="Output">
            <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
          </button>
        </nav>
        <section class="pane" id="pane-project">
          <h2>project</h2>
          <demo-tree id="file-tree"></demo-tree>
          <div class="tab-scroller">
            <lion-tabs id="open-files"></lion-tabs>
          </div>
          <playground-project id="project" sandbox-base-url={sandboxBaseUrl}></playground-project>
          <playground-file-editor id="editor"></playground-file-editor>
        </section>

        <section class="pane" id="pane-run">
          <h2>run</h2>
          <p id="status" class="status" role="status">Not run yet.</p>
          <playground-preview id="preview"></playground-preview>
          <div id="busy" hidden><lion-progress-indicator indeterminate label="Running"></lion-progress-indicator></div>
          <div id="node-panes">
            <pre id="output" class="terminal" aria-label="Program output"></pre>
            <ul id="files" aria-label="Resulting files"></ul>
          </div>
          <!-- Lion's accordion cannot be themed: measured no `--lion-*` tokens, no `::part` and no `:host`
               background in the component, so it paints its own light chrome on a dark surface. A native
               `<details>` is a disclosure this page owns and can style; the Lion components stay where they can
               carry the look — the tree (the menu system), the tabs, the busy indicator. -->
          <details class="checks">
            <summary>checks</summary>
            <p id="content-check" class="status"></p>
            <ul id="findings" aria-label="Content check findings"></ul>
            <p id="governance" class="status" aria-label="Governance check"></p>
            <h3>packages you can import</h3>
            <ul id="packages" aria-label="Importable packages"></ul>
            <p class="note">
              A builtin the layer does not answer — <code>module</code>, <code>child_process</code>,
              <code>http</code> — fails with <em>Failed to resolve module specifier</em>. That is the honest
              boundary, not a bug: those need a real runtime.
            </p>
          </details>
          <p class="note" id="mode-note"></p>
        </section>
      </div>

      <!-- CodeSandbox's mobile shape: one thing at a time, switched from a fixed bar at the bottom, drawn with the
           icons their interface actually uses (Material Symbols Outlined — measured — over Inter, also measured). -->
      <nav class="mobile-tabs" aria-label="View">
        <button type="button" data-view="files">
          <span class="material-symbols-outlined" aria-hidden="true">folder</span>
          <span>Files</span>
        </button>
        <button type="button" data-view="code" class="is-active">
          <span class="material-symbols-outlined" aria-hidden="true">code</span>
          <span>Code</span>
        </button>
        <button type="button" data-view="preview">
          <span class="material-symbols-outlined" aria-hidden="true">smartphone</span>
          <span>Preview</span>
        </button>
        <button type="button" data-view="output">
          <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
          <span>Output</span>
        </button>
      </nav>
    </main>

    <script>
      import 'playground-elements/playground-project.js';
      import 'playground-elements/playground-file-editor.js';
      import 'playground-elements/playground-preview.js';
      // The file tree is Lion's own. `LionTree` was removed from the package and survives as
      // `docs/components/menu/src/DemoTree.js` — a `MultiLevelListMixin` host with `role="tree"` — which is the
      // configuration the menu system's own docs and migration guide point at.
      import { DemoTree } from '../../../docs/components/menu/src/DemoTree.js';
      // The chrome is Lion's where it can carry the look: the tree is the menu system, the tabs are Lion's, the busy
      // state is Lion's progress indicator. The accordion is not here — it has no theming surface (see the markup
      // comment). Dark mode is the portal header's, not this page's: see ThemeInit and TopNav.
      import '@lion/ui/define/lion-progress-indicator.js';

      void DemoTree;

      const _base = import.meta.env.BASE_URL;
      const base = _base.endsWith('/') ? _base : `${_base}/`;
      const assetsBase = `${base}lion-playground-node-demo/`;
      // Absolute: the shim urls are derived from the engine's own directory, so that the engine and a demo
      // reach the *same* shim module. A shim reached by two urls is two module instances with two filesystems.
      const engineUrl = new URL(`${assetsBase}engine.js`, location.href).href;
      // The posture is configured, never inferred: false means the sandbox has its own origin (the browser is
      // the boundary), true is the explicit opt-in that makes the worker set a policy and the check a gate.
      const sameOriginSandbox = import.meta.env.PUBLIC_SAME_ORIGIN_SANDBOX === 'true';

      // Not `<playground-ide>`: the ide is just these three elements side by side, and composing them ourselves is
      // what makes the editor tabs ours. The ide keeps the file editor, the preview and the tab bar in its own
      // shadow root, and it has no public way to select a file — the tab bar sets `editor.filename` directly —
      // whereas `project.config` is exactly the shape this page already builds.
      const project = document.querySelector('#project');
      const editor = document.querySelector('#editor');
      const preview = document.querySelector('#preview');
      editor.project = project;
      preview.project = project;
      preview.htmlFile = 'index.html';
      const modeTabs = document.querySelector('#modes');
      const status = document.querySelector('#status');
      const contentCheck = document.querySelector('#content-check');
      const findingsList = document.querySelector('#findings');
      const output = document.querySelector('#output');
      const nodePanes = document.querySelector('#node-panes');
      const filesList = document.querySelector('#files');
      const packagesList = document.querySelector('#packages');
      const modeNote = document.querySelector('#mode-note');
      const governance = document.querySelector('#governance');
      const busy = document.querySelector('#busy');
      let fileTree = document.querySelector('#file-tree');

      // A tree in Lion today is markup, not a component API: a `demo-tree` holds `role="treeitem"` items and, for
      // a folder, another `demo-tree` beside the item — the menu system's `MultiLevelListMixin` contract.
      //
      // The mixin reads its items when it upgrades, so filling an existing tree afterwards leaves it inert
      // (measured: the element defined, `aria-level`/`aria-posinset`/`aria-setsize` never set, no `role="tree"`).
      // A fresh host with its children already in place is the condition the docs' static markup has, so that is
      // what this builds — and the items are the project's flat file list turned into that nesting.
      // File-type icons come from the same Material Symbols set the mobile bar uses, so the tree and the tabs read
      // at a glance the way an editor's do.
      const iconForFile = name => {
        if (name.endsWith('.html')) return 'html';
        if (name.endsWith('.js') || name.endsWith('.mjs')) return 'javascript';
        if (name.endsWith('.json')) return 'data_object';
        if (name.endsWith('.css')) return 'css';
        if (name.endsWith('.md')) return 'description';
        return 'draft';
      };

      const withIcon = (element, iconName) => {
        const icon = document.createElement('span');
        icon.className = 'material-symbols-outlined';
        icon.setAttribute('aria-hidden', 'true');
        icon.textContent = iconName;
        element.prepend(icon);
      };

      // The files sit under one root folder named for the project, so the tree reads as structure — a folder,
      // indented children, a disclosure — and not as a second row of tabs. Lion's menu system makes a folder row
      // the invoker of the group after it but does not open or close it here (its disclosure wiring is not in
      // this mixin), so the page owns that: `aria-expanded` on the row, `hidden` on the group.
      const renderTree = (mount, files, rootName) => {
        const root = { children: new Map() };
        for (const name of Object.keys(files)) {
          const parts = name.split('/');
          let node = root;
          parts.forEach((part, index) => {
            if (!node.children.has(part)) node.children.set(part, { children: new Map() });
            node = node.children.get(part);
            if (index === parts.length - 1) node.file = name;
          });
        }
        const next = document.createElement('demo-tree');
        next.id = mount.id;
        const treeItem = (parent, name, iconName) => {
          const item = document.createElement('div');
          item.setAttribute('role', 'treeitem');
          const label = document.createElement('span');
          label.textContent = name;
          item.append(label);
          withIcon(item, iconName);
          parent.appendChild(item);
          return item;
        };
        const folder = (parent, name, node) => {
          const item = treeItem(parent, name, 'folder_open');
          item.dataset.folder = '';
          item.setAttribute('aria-expanded', 'true');
          const group = document.createElement('demo-tree');
          append(group, node);
          parent.appendChild(group);
          item.addEventListener('click', () => {
            const open = item.getAttribute('aria-expanded') !== 'true';
            item.setAttribute('aria-expanded', String(open));
            item.querySelector('.material-symbols-outlined').textContent = open ? 'folder_open' : 'folder';
            group.hidden = !open;
          });
        };
        function append(parent, node) {
          for (const [part, child] of node.children) {
            if (child.file) {
              const item = treeItem(parent, part, iconForFile(part));
              item.dataset.file = child.file;
              item.addEventListener('click', () => {
                openFile(child.file);
              });
            } else if (child.children.size) {
              folder(parent, part, child);
            }
          }
        }
        if (rootName) folder(next, rootName, root);
        else append(next, root);
        mount.replaceWith(next);
        return next;
      };

      // Editor tabs, à la StackBlitz: the open files are the user's list, not the filesystem's order — closing a tab
      // does not delete a file, and the order is the user's to change. Lion's tabs own `role="tab"`, the roving
      // tabindex and the aria wiring; a tab element is a plain div here so the close button can legitimately live
      // inside it. Lion pairs every tab with a panel (it asserts equal counts), so each tab gets an empty one and the
      // editor is the real panel — it cannot be re-parented into a Lion panel without re-initialising CodeMirror.
      const openFilesBar = document.querySelector('#open-files');
      let openFiles = [];
      let activeFile = null;
      let draggedFile = null;

      const renderOpenFiles = () => {
        openFilesBar.textContent = '';
        openFiles.forEach(name => {
          const tab = document.createElement('div');
          tab.slot = 'tab';
          tab.draggable = true;
          tab.dataset.file = name;
          const label = document.createElement('span');
          label.textContent = name;
          const close = document.createElement('button');
          close.type = 'button';
          close.className = 'close';
          close.setAttribute('aria-label', `Close ${name}`);
          withIcon(close, 'close');
          close.addEventListener('click', event => {
            event.stopPropagation();
            closeOpenFile(name);
          });
          tab.append(label, close);
          withIcon(tab, iconForFile(name));
          tab.addEventListener('dragstart', event => {
            draggedFile = name;
            tab.classList.add('dragging');
            event.dataTransfer?.setData('text/plain', name);
          });
          tab.addEventListener('dragend', () => {
            tab.classList.remove('dragging');
            draggedFile = null;
            commitTabOrder();
          });
          // A drag that shows the result while it happens: the tab follows the pointer, and the *DOM node* moves
          // rather than the list re-rendering — replacing the dragged element mid-drag cancels the drag itself.
          tab.addEventListener('dragover', event => {
            if (!draggedFile || draggedFile === name) return;
            event.preventDefault();
            const dragged = openFilesBar.querySelector(
              `[slot="tab"][data-file="${CSS.escape(draggedFile)}"]`,
            );
            if (!dragged || dragged === tab) return;
            const rect = tab.getBoundingClientRect();
            const afterPointer = event.clientX > rect.left + rect.width / 2;
            openFilesBar.insertBefore(dragged, afterPointer ? tab.nextSibling : tab);
            if (dragged.__panel) openFilesBar.insertBefore(dragged.__panel, dragged.nextSibling);
          });
          tab.addEventListener('drop', event => {
            event.preventDefault();
            commitTabOrder();
          });
          openFilesBar.appendChild(tab);
          // Lion decorates its slotted tabs (`role="tab"`, `aria-controls` and the key handlers) from a
          // `slotchange` listener, but measured it does not for tabs added after it upgraded: role stayed null and
          // tabindex -1. So the page completes what Lion's own `setupButton` would have set rather than shipping a
          // tablist without tab semantics — the roving tabindex is the ARIA APG one, 0 on the selected tab.
          if (!tab.getAttribute('role')) tab.setAttribute('role', 'tab');
          tab.setAttribute('aria-selected', String(name === activeFile));
          tab.tabIndex = name === activeFile ? 0 : -1;
          if (!tab.hasAttribute('aria-controls')) tab.setAttribute('aria-controls', 'editor');
          const panel = document.createElement('div');
          panel.slot = 'panel';
          panel.hidden = true;
          panel.setAttribute('aria-hidden', 'true');
          // The panel that Lion requires per tab travels with its tab, so a live reorder cannot separate the pair.
          tab.__panel = panel;
          openFilesBar.appendChild(panel);
        });
        openFilesBar.selectedIndex = Math.max(0, openFiles.indexOf(activeFile));
        // The tree marks the open file as well, so the two never disagree about what is being edited.
        for (const item of fileTree.querySelectorAll('[role="treeitem"][data-file]')) {
          if (item.dataset.file === activeFile) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        }
      };

      const openFile = name => {
        if (!openFiles.includes(name)) openFiles = [...openFiles, name];
        activeFile = name;
        editor.filename = name;
        renderOpenFiles();
      };

      const closeOpenFile = name => {
        const index = openFiles.indexOf(name);
        openFiles = openFiles.filter(file => file !== name);
        if (activeFile === name) {
          // Closing the active tab activates its neighbour rather than nothing, which is what an editor does.
          activeFile = openFiles[Math.min(index, openFiles.length - 1)] ?? null;
          if (activeFile) editor.filename = activeFile;
        }
        renderOpenFiles();
      };

      /**
       * The order the user dragged is the DOM order, so it is read back from there rather than reconstructed from
       * indices — a live drag moves nodes, and only the DOM knows what the user ended up looking at.
       */
      const commitTabOrder = () => {
        const order = [...openFilesBar.querySelectorAll('[slot="tab"]')].map(tab => tab.dataset.file);
        if (order.length === openFiles.length) openFiles = order;
        draggedFile = null;
        renderOpenFiles();
      };

      const moveOpenFile = (name, beforeName) => {
        if (!name || name === beforeName) return;
        const next = openFiles.filter(file => file !== name);
        next.splice(next.indexOf(beforeName), 0, name);
        openFiles = next;
        renderOpenFiles();
      };

      const reorderOpenFile = (name, delta) => {
        const from = openFiles.indexOf(name);
        const to = from + delta;
        if (to < 0 || to >= openFiles.length) return;
        openFiles = openFiles.map((file, index) =>
          index === from ? openFiles[to] : index === to ? openFiles[from] : file,
        );
        renderOpenFiles();
      };

      openFilesBar.addEventListener('click', event => {
        const tab = event.target.closest('[slot="tab"]');
        if (tab?.dataset.file) openFile(tab.dataset.file);
      });
      // Dragging is not accessible on its own, so the same move has a keyboard form. It is bound on the document
      // because a tab div is not reliably focusable — Lion manages the roving tabindex itself — and it acts on the
      // selected tab. Events from inside the editor are left alone: CodeMirror has its own use for Alt+arrows.
      document.addEventListener('keydown', event => {
        if (!event.altKey || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
        if (event.target instanceof Element && event.target.closest('#editor')) return;
        if (!activeFile) return;
        event.preventDefault();
        reorderOpenFile(activeFile, event.key === 'ArrowLeft' ? -1 : 1);
      });

      // The theme is the portal's, not this page's: the header's radio group drives `data-theme` on <html> through
      // `public/styles/theme.css` and ThemeInit keeps the stored choice in sync, so there is nothing to wire here.
      // The page's dark rules below simply follow that attribute.

      // Booted by the project's own index.html. It reads the project's files from the served filesystem — that
      // is the mechanism, and it is what makes an edit in the editor re-run with the new content instead of
      // re-running a payload baked into the document. Server rendering needs the same three things a browser
      // needs and one it does not: an entry, the files that entry reads, and somewhere to write, plus a string
      // instead of a mounted document.
      const bootSourceFor = ({ names, entry }) => `const names = ${JSON.stringify(names)};
const files = {};
let styles = '';
for (const name of names) {
  const response = await fetch(name);
  const content = await response.text();
  if (name.endsWith('.css')) styles = content;
  else files['/' + name] = { content };
}
if (styles) {
  const style = document.createElement('style');
  style.textContent = styles;
  document.head.appendChild(style);
}
window.__nodeDemoRunnerPayload = { entry: ${JSON.stringify(entry)}, files };

// What this document can actually do, measured *here* rather than assumed by the page. The worker's policy is
// what stands in for a boundary in the same-origin posture, so its presence is checked instead of trusted.
const policy = await fetch(location.href).then(
  response => response.headers.get('content-security-policy'),
  () => null,
);
let evalOutcome = 'allowed';
try {
  (0, eval)('1 + 1');
} catch (error) {
  evalOutcome = 'blocked: ' + error.name;
}
let crossOriginOutcome = 'reached';
try {
  await fetch('https://example.com/', { mode: 'no-cors' });
} catch (error) {
  crossOriginOutcome = 'blocked';
}
window.parent.postMessage(
  {
    source: 'lion-node-demo-runner-governance',
    origin: location.origin,
    controlled: Boolean(navigator.serviceWorker.controller),
    policy,
    eval: evalOutcome,
    crossOrigin: crossOriginOutcome,
  },
  '*',
);

await import(${JSON.stringify(engineUrl)});
`;

      // The preview canvas, shared by all three modes. It renders somebody else's document, so it stays light, but
      // it is an off-white rather than a white so it sits in the dark shell instead of glaring out of it, and it has
      // the room a canvas needs: 28px / 32px of padding, a heading with weight, and a form that does not stretch to
      // the full width of the frame. The preview element paints the same value behind it (see the stylesheet), so
      // the canvas and its frame agree while the document loads.
      const canvasStyles = `:root {
  color-scheme: light;
}
body {
  font-family: system-ui, sans-serif;
  background: #f3f3f4;
  color: #1c1c20;
  line-height: 1.5;
  padding: 28px 32px;
  margin: 0;
}
h1 {
  font-size: 1.125rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 1rem;
}
lion-input, lion-button {
  display: block;
  max-width: 24rem;
  margin-bottom: 0.75rem;
}
`;

      const modes = {
        browser: {
          note: 'Browser mode: index.html is the document and main.js is its module. There is no filesystem to write to — the demo is the page.',
          files: {
            'index.html': [
              '<link rel="stylesheet" href="./styles.css">',
              '<h1>A Lion component, in browser mode</h1>',
              '<lion-input label="Your name"></lion-input>',
              '<lion-button>Save</lion-button>',
              // A literal script end tag in this string would end the inline script that contains it, so the
              // slash is escaped — the browser sees the tag, the HTML parser does not see the end of mine.
              '<script type="module" src="./main.js"><\/script>',
              '',
            ].join('\n'),
            'styles.css': canvasStyles,
            'main.js': `import '@lion/ui/define/lion-input.js';
import '@lion/ui/define/lion-button.js';

const button = document.querySelector('lion-button');
button.addEventListener('click', () => {
  button.textContent = 'Saved';
});
`,
          },
        },
        node: {
          note: 'Node mode: the entry runs against the shim layer, reading the project’s own files, so it reads and writes files and reports output. A builtin the layer does not answer — module, child_process, http — fails with “Failed to resolve module specifier”.',
          names: ['demo.js', 'styles.css', 'data.json'],
          entry: '/demo.js',
          files: {
            'index.html': '<script type="module" src="./boot.js"><\/script>\n',
            'demo.js': `import '@lion/ui/define/lion-button.js';
import '@lion/ui/define/lion-input.js';
import { readFileSync, writeFileSync, readdirSync } from 'fs';
import { basename } from 'path';

const data = JSON.parse(readFileSync('/data.json', 'utf8'));

document.body.innerHTML = [
  '<h1>' + data.title + '</h1>',
  '<lion-input label="' + data.field + '"></lion-input>',
  '<lion-button>' + data.action + '</lion-button>',
].join('');

await customElements.whenDefined('lion-button');
await customElements.whenDefined('lion-input');
await document.querySelector('lion-input').updateComplete;

writeFileSync('/out.txt', data.action.toUpperCase());
console.log('components registered:', ['lion-button', 'lion-input'].every(t => customElements.get(t)));
console.log('wrote', basename('/out.txt'), '->', readFileSync('/out.txt', 'utf8'));
console.log('files here:', readdirSync('/').join(', '));
`,
            'data.json': `{
  "title": "A Lion component, run by the Node layer",
  "field": "Your name",
  "action": "Save"
}
`,
            'styles.css': canvasStyles,
          },
        },
        ssr: {
          note: 'SSR mode: the same Node layer renders a Lion component to a string with @lit-labs/ssr — no document, no mount, a string — and then the browser adopts exactly that string and lets the components hydrate in place. The string is printed below, so you can read what the server sent.',
          names: ['server.js', 'styles.css', 'data.json'],
          entry: '/server.js',
          files: {
            'index.html': '<script type="module" src="./boot.js"><\/script>\n',
            'server.js': `import { html } from 'lit';
import { render } from '@lit-labs/ssr';
// \`index.js\` re-exports \`render\` and the element renderers, not the collectors: those live in
// \`lib/render-result.js\`, and since this package has no exports map that subpath is a plain specifier the
// import map already carries.
import { collectResult } from '@lit-labs/ssr/lib/render-result.js';
import '@lit-labs/ssr-client/lit-element-hydrate-support.js';
import { hydrate } from '@lit-labs/ssr-client';
import '@lion/ui/define/lion-button.js';
import '@lion/ui/define/lion-input.js';
import { readFileSync } from 'fs';

const data = JSON.parse(readFileSync('/data.json', 'utf8'));
const template = html\`<h1>\${data.title}</h1>
<lion-input label="\${data.field}"></lion-input>
<lion-button>\${data.action}</lion-button>\`;

// What a server does: no document, no mount — a string.
const serverHtml = await collectResult(render(template));
console.log('the server rendered', serverHtml.length, 'characters:');
console.log(serverHtml);

// What the browser then does with those very bytes: adopt them, and let the same components hydrate in place.
document.body.innerHTML = serverHtml;
await hydrate(template, document.body);
await customElements.whenDefined('lion-button');
await customElements.whenDefined('lion-input');
console.log('hydrated; the button in the document is', document.querySelector('lion-button').constructor.name);
`,
            'data.json': `{
  "title": "Rendered on the server, hydrated here",
  "field": "Your name",
  "action": "Save"
}
`,
            'styles.css': canvasStyles,
          },
        },
      };

      const contentTypeFor = name =>
        name.endsWith('.html')
          ? 'text/html'
          : name.endsWith('.css')
            ? 'text/css'
            : name.endsWith('.json')
              ? 'application/json'
              : 'sample/js';

      let mode = 'browser';
      let assets = null;
      const load = specifier => import(/* @vite-ignore */ specifier);
      const loadAssets = async () => {
        if (!assets) {
          const [importMapPerPackage, packageMains, host] = await Promise.all([
            load(`${assetsBase}importMapPerPackage.js`).then(module => module.default),
            load(`${assetsBase}packageMains.js`).then(module => module.default),
            load(`${assetsBase}host.js`),
            load(`${assetsBase}checkDemoContent.js`).then(module => (assets = { ...assets, ...module })).catch(() => {}),
          ]);
          assets = { ...assets, importMapPerPackage, packageMains, host };
        }
        return assets;
      };

      const report = { log: [], exitCode: null, files: {} };
      const showReport = () => {
        output.textContent = '';
        for (const entry of report.log) {
          output.textContent += entry.stream === 'stderr' ? `! ${entry.text}` : entry.text;
        }
        filesList.textContent = '';
        for (const [pathname, content] of Object.entries(report.files || {})) {
          const item = document.createElement('li');
          item.textContent = `${pathname} (${content.length} chars)`;
          filesList.appendChild(item);
        }
      };

      // The report arrives from the served document, whose parent is this page. The marker is what identifies it:
      // an identity check on one frame would reject the engine now that the worker serves it in a nested frame.
      window.addEventListener('message', event => {
        const data = event.data;
        if (!data) return;
        // Either message means the served document is up and reporting, so the wait is over.
        if (data.source === 'lion-node-demo-runner' || data.source === 'lion-node-demo-runner-governance') {
          busy.hidden = true;
        }
        if (data.source === 'lion-node-demo-runner-governance') {
          // The posture is a promise the deployment makes; this is the measurement of whether it holds. In the
          // same-origin posture the worker's policy is what stands in for the boundary, so a missing policy is a
          // mismatch, not a detail. In the other posture there is no policy to show, and that is correct.
          const hasPolicy = Boolean(data.policy);
          const consistent = sameOriginSandbox ? hasPolicy : true;
          governance.textContent = [
            `served by the worker: ${data.controlled ? 'yes' : 'no'}`,
            `policy: ${hasPolicy ? 'set by the worker' : 'none'}`,
            `eval: ${data.eval}`,
            `cross-origin fetch: ${data.crossOrigin}`,
            sameOriginSandbox
              ? `same-origin opt-in: ${consistent ? 'policy present, as promised' : 'NO POLICY — the promise does not hold'}`
              : 'own-origin posture: no policy expected, the browser is the boundary',
          ].join(' · ');
          governance.dataset.consistent = String(consistent);
          return;
        }
        if (data.source !== 'lion-node-demo-runner') return;
        report.log = data.log || [];
        report.exitCode = data.exitCode;
        report.files = data.files || {};
        showReport();
        status.textContent = `Finished with exit code ${report.exitCode}.`;
        status.dataset.state = report.exitCode === 0 ? 'ok' : 'error';
      });

      const applyMode = async name => {
        mode = name;
        for (const tab of modeTabs.querySelectorAll('[role="tab"]')) {
          tab.setAttribute('aria-selected', String(tab.dataset.mode === name));
        }
        modeNote.textContent = modes[name].note;
        nodePanes.hidden = name === 'browser';
        status.textContent = 'Not run yet.';
        // The state drives the dot beside the status text (see the stylesheet); the text stays the message.
        status.dataset.state = 'running';
        busy.hidden = false;
        report.log = [];
        report.files = {};
        output.textContent = '';
        filesList.textContent = '';

        const { importMapPerPackage, packageMains, host, checkDemoContent, describeContentReport, decideRun } =
          await loadAssets();

        if (!packagesList.childElementCount) {
          for (const packageName of Object.keys(importMapPerPackage)) {
            const item = document.createElement('li');
            item.textContent = packageName;
            packagesList.appendChild(item);
          }
        }

        // What the content does, before the preview runs it. With the sandbox on its own origin this is
        // information for a reviewer; on this origin it is the gate, because there nothing but the worker's
        // policy and this review stands between a demo and this origin's cookies and storage.
        const contentReport = checkDemoContent(modes[name].files);
        const decision = decideRun({ report: contentReport, sameOriginSandbox });
        contentCheck.textContent = `${describeContentReport(contentReport)} — ${decision.reason}`;
        findingsList.textContent = '';
        for (const finding of contentReport.findings) {
          const item = document.createElement('li');
          item.textContent = `${finding.file}:${finding.line} ${finding.rule} (${finding.severity})`;
          findingsList.appendChild(item);
        }
        if (!decision.allow) {
          ide.config = { importMap: { imports: {} }, files: {} };
          status.textContent = decision.reason;
          status.dataset.state = 'error';
          return;
        }

        const importMap = host.buildFenceImportMap(
          { importMapPerPackage, packageMains },
          location.origin,
          new URL('./shims', engineUrl).href,
        );
        // The map has to be *in the document*, not only in the project config: the config drives
        // playground-elements' own rewriting, while the packages a demo imports keep their bare specifiers and
        // need the document's map. Written with an escaped slash, so the HTML parser does not read it as the end
        // of the script that contains this string.
        const importMapScript = `<script type="importmap">${JSON.stringify(importMap).replace(/</g, '\\u003c')}<\/script>`;

        const projectFiles = { ...modes[name].files };
        if (modes[name].entry) {
          projectFiles['boot.js'] = bootSourceFor({ names: modes[name].names, entry: modes[name].entry });
        }
        fileTree = renderTree(fileTree, projectFiles, `${name}-demo`);

        project.config = {
          importMap,
          files: Object.fromEntries(
            Object.entries(projectFiles).map(([fileName, content]) => [
              fileName,
              {
                filename: fileName,
                contentType: contentTypeFor(fileName),
                content: fileName.endsWith('.html') ? `${importMapScript}\n${content}` : content,
              },
            ]),
          ),
        };
        editor.filename = modes[name].entry ? modes[name].entry.replace(/^\//, '') : 'index.html';
        openFiles = Object.keys(projectFiles);
        activeFile = editor.filename;
        renderOpenFiles();
        status.textContent = 'Served by the worker; the preview runs it.';
        // Browser mode is done here; the node modes stay "running" until their report arrives.
        status.dataset.state = modes[name].entry ? 'running' : 'ok';
        // Browser mode posts no report — nothing but the preview runs there — so the wait ends when the config is
        // in place rather than when a message arrives, or the indicator would spin forever.
        busy.hidden = true;
      };

      for (const name of Object.keys(modes)) {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.setAttribute('role', 'tab');
        tab.dataset.mode = name;
        // The mode is the label and what it runs is a quieter hint beside it; the space between the two spans is
        // a real text node so the accessible name reads "node modules + fs", not "nodemodules + fs".
        const [label, hint] = {
          browser: ['browser', 'html + js'],
          node: ['node', 'modules + fs'],
          ssr: ['ssr', 'server render + hydrate'],
        }[name];
        const labelSpan = document.createElement('span');
        labelSpan.className = 'mode-name';
        labelSpan.textContent = label;
        const hintSpan = document.createElement('span');
        hintSpan.className = 'mode-hint';
        hintSpan.textContent = hint;
        tab.append(labelSpan, ' ', hintSpan);
        tab.addEventListener('click', () => applyMode(name));
        modeTabs.appendChild(tab);
      }

      // The view model: one attribute on <body>, driven from whichever affordance the width offers — the rail on a
      // desktop, the bar at the bottom on a phone. Show/hide lives in CSS, so there is one source of truth.
      const viewControls = [...document.querySelectorAll('.view-rail button, .mobile-tabs button')];
      const setView = view => {
        document.body.dataset.view = view;
        for (const button of viewControls) {
          button.classList.toggle('is-active', button.dataset.view === view);
        }
      };
      for (const rail of [document.querySelector('.view-rail'), document.querySelector('.mobile-tabs')]) {
        rail.addEventListener('click', event => {
          const button = event.target.closest('button[data-view]');
          if (button) setView(button.dataset.view);
        });
      }
      // The default view depends on the width: the full layout on a desktop, the editor alone on a phone, where the
      // bar offers the other views. Same model either way.
      setView(window.innerWidth < 768 ? 'code' : 'files');

      applyMode('browser');
    </script>

    <style is:global>
      /* One stylesheet, one design language. The block is `is:global` because almost everything it styles is
         global from Astro's point of view — the portal header (TopNav), Lion's tree and tabs, the playground
         elements' parts and custom properties, the items the script creates at runtime — and a page's styles
         only load on that page, so "global" here still means this page.

         The language, measured from StackBlitz's own stylesheet and kept in this page's dark family:
         - type: Inter for the UI at 400 / 500 / 600 (headings 600), JetBrains Mono for every code surface;
         - motion: 0.1s for state changes, 0.16s for movement, `ease`, nothing that bounces;
         - surfaces: three greys (page, panel, inset) separated by a hairline ring and one soft shadow — not a
           border on every box;
         - radius: 8px panels, 6px insets and controls, 4px for small things;
         - colour: one accent (their blue) for selection and focus, mint for success, red for failure. */
      :root {
        --pg-ui: Inter, system-ui, sans-serif;
        --pg-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

        /* The page around the app follows the portal's theme switch (light-dark() resolves the portal's
           `color-scheme`, which theme.css sets for light, dark and auto alike); the app itself is dark in both. */
        --pg-page: light-dark(#f4f4f5, #0b0b0d);
        --pg-page-fg: light-dark(#18181b, #ededef);
        --pg-page-muted: light-dark(#5f5f67, hsl(0 0% 62%));
        --pg-page-chip: light-dark(rgb(0 0 0 / 0.06), rgb(255 255 255 / 0.07));

        --pg-chrome: #0b0b0d; /* header and the phone's bottom bar */
        --pg-surface: #161618; /* panels and the rail */
        --pg-inset: #101012; /* editor, console, the mode control */
        --pg-strip: #131315; /* the tab strip and the preview toolbar */
        --pg-hover: rgb(255 255 255 / 0.05);
        --pg-selected: #26262b;
        --pg-line: rgb(255 255 255 / 0.07);
        --pg-line-strong: rgb(255 255 255 / 0.12);

        --pg-fg: #ededef;
        --pg-fg-2: #c2c2c8;
        --pg-muted: hsl(0 0% 62%);
        --pg-faint: #6c6c74;

        --pg-accent: rgb(0 168 219);
        --pg-ok: rgb(51 255 204);
        --pg-error: rgb(237 94 106);

        --pg-shadow: 0 0 0 1px var(--pg-line), 0 1px 2px rgb(0 0 0 / 0.35), 0 12px 32px -16px rgb(0 0 0 / 0.6);
        --pg-r-lg: 8px;
        --pg-r: 6px;
        --pg-r-sm: 4px;
        --pg-fast: 0.1s ease;
        --pg-med: 0.16s ease;
      }

      html body { background-color: var(--pg-page); }

      main {
        margin: 0 auto;
        max-width: 84rem;
        /* 48px fixed header + 24px: the content clears the bar by the same 24px it keeps from the sides. */
        padding: 72px 24px 24px;
        font-family: var(--pg-ui);
        line-height: 1.5;
        color: var(--pg-page-fg);
      }
      [hidden] { display: none !important; }

      /* --- the header ------------------------------------------------------------------------------------------
         The header is `header.site-header`, and the portal's own rule for it wins over `body > header`,
         `header.site-header` and `html body header.site-header` alike — it carries `!important`, so there is no
         specificity left that wins. This page therefore marks `!important` on exactly the properties it changes:
         a 48px bar, fixed at the top, on the app's chrome colour with a hairline under it, the theme switch
         staying inside the navigation where TopNav renders it. Page-scoped: the docs site keeps its own header. */
      html body header.site-header {
        background: var(--pg-chrome) !important;
        backdrop-filter: none !important;
        border-bottom: 1px solid var(--pg-line) !important;
        display: flex !important;
        align-items: center !important;
        height: 48px !important;
        min-height: 48px !important;
        max-height: 48px !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        z-index: 50 !important;
        /* The wordmark's first half is `fill="currentColor"`, so it inherits this — setting the header's own
           colour is what keeps it light on the dark bar; targeting a/span/li never would. */
        color: var(--pg-fg);
      }
      html body header.site-header a,
      html body header.site-header span,
      html body header.site-header li,
      html body header.site-header button { color: var(--pg-muted); transition: color var(--pg-fast); }
      html body header.site-header a:hover,
      html body header.site-header button:hover { color: var(--pg-fg); }
      html body header.site-header .theme-switch label {
        color: var(--pg-muted); background: transparent; transition: color var(--pg-fast);
      }
      html body header.site-header .theme-switch [type='radio']:checked + label {
        color: var(--pg-fg); background: transparent;
      }

      /* The wordmark: both halves at weight 400 and the accent half in grey, so the mark reads as one quiet word.
         The component sets 600 on `.wordmark-glyphs`, so the selector matches that specificity and wins on order.
         Page-scoped on purpose: on the docs site the yellow and the heavier weight are deliberate. */
      .logo-text-svg text.wordmark-glyphs { font-weight: 400; }
      .logo-text-svg text.wordmark-accent { fill: var(--pg-muted); stroke: none; }

      /* --- the intro: type on the page, not another box ------------------------------------------------------ */
      main > header { margin: 0 0 16px; text-align: left; }
      main > header h1 {
        margin: 0;
        font-size: 20px;
        line-height: 1.3;
        font-weight: 600;
        letter-spacing: -0.015em;
        color: var(--pg-page-fg);
      }
      .lede {
        margin: 6px 0 0;
        max-width: 76ch;
        font-size: 14px;
        line-height: 1.6;
        color: var(--pg-page-muted);
      }
      .lede strong { font-weight: 500; color: var(--pg-page-fg); }
      .lede code {
        font-family: var(--pg-mono);
        font-size: 12.5px;
        padding: 1px 3px;
        border-radius: var(--pg-r-sm);
        background: var(--pg-page-chip);
        color: inherit;
      }

      /* --- focus: one ring for every control in the app -----------------------------------------------------
         The portal's global rule draws a dotted outline; the app replaces it with the accent, solid. */
      .playground-app :is(button, summary, [role='tab'], [role='treeitem']):focus-visible,
      .mobile-tabs button:focus-visible {
        outline: 2px solid var(--pg-accent);
        outline-offset: 2px;
      }

      /* --- the toolbar: the mode switch is a segmented control ---------------------------------------------- */
      .toolbar.playground-app {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 0 0 16px;
      }
      #modes {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        border-radius: 8px;
        background: var(--pg-inset);
        box-shadow: 0 0 0 1px var(--pg-line);
      }
      #modes [role='tab'] {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        height: 30px;
        padding: 0 12px;
        border: 0;
        border-radius: var(--pg-r);
        background: transparent;
        color: var(--pg-muted);
        font: 500 13px/30px var(--pg-ui);
        white-space: nowrap;
        cursor: pointer;
        transition: color var(--pg-fast), background-color var(--pg-fast), box-shadow var(--pg-fast);
      }
      #modes .mode-hint { font-weight: 400; color: var(--pg-faint); transition: color var(--pg-fast); }
      #modes [role='tab']:hover { color: var(--pg-fg); background: var(--pg-hover); }
      #modes [role='tab'][aria-selected='true'] {
        color: var(--pg-fg);
        background: var(--pg-selected);
        box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 1px 2px rgb(0 0 0 / 0.5);
      }
      #modes [role='tab'][aria-selected='true'] .mode-hint { color: var(--pg-muted); }
      #modes [role='tab']:active { background: var(--pg-selected); }

      /* --- the app grid: rail, project, run — all three stretched to one bottom edge ------------------------- */
      .playground.playground-app {
        display: grid;
        grid-template-columns: auto minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 24px;
        align-items: stretch;
      }

      /* The editor's look, assigned through the custom properties playground-elements ships for exactly this —
         the palette is configuration, never a reach into its shadow DOM. */
      .playground-app {
        --playground-code-background: var(--pg-inset);
        --playground-code-default-color: #d4d4d8;
        --playground-code-font-family: var(--pg-mono);
        --playground-code-font-size: 13.5px;
        --playground-code-line-height: 1.7;
        --playground-code-padding: 12px 0;
        --playground-code-line-padding: 0 16px 0 12px;
        --playground-code-gutter-background: var(--pg-inset);
        --playground-code-gutter-border-right: 0;
        --playground-code-gutter-box-shadow: none;
        --playground-code-linenumber-color: #4b4b53;
        --playground-code-cursor-color: var(--pg-accent);
        --playground-code-selection-background: #1d3b52;
        --playground-highlight-color: #1d3b52;
        --playground-code-comment-color: #6b7280;
        --playground-code-keyword-color: #c586c0;
        --playground-code-string-color: #ce9178;
        --playground-code-string-2-color: #d7ba7d;
        --playground-code-number-color: #b5cea8;
        --playground-code-variable-color: #9cdcfe;
        --playground-code-variable-2-color: #9cdcfe;
        --playground-code-variable-3-color: #4ec9b0;
        --playground-code-def-color: #dcdcaa;
        --playground-code-type-color: #4ec9b0;
        --playground-code-tag-color: #569cd6;
        --playground-code-attribute-color: #9cdcfe;
        --playground-code-property-color: #9cdcfe;
        --playground-code-operator-color: #d4d4d8;
        --playground-code-meta-color: #d7ba7d;
        --playground-code-atom-color: #569cd6;
        --playground-code-builtin-color: #4ec9b0;
        --playground-code-callee-color: #dcdcaa;
        --playground-code-qualifier-color: #dcdcaa;
        --playground-border: 1px solid var(--pg-line);
        --playground-bar-height: 36px;
        --playground-floating-controls-color: var(--pg-muted);
        --playground-preview-toolbar-background: var(--pg-strip);
        --playground-preview-toolbar-foreground-color: var(--pg-muted);
        --playground-tab-bar-background: var(--pg-strip);
        --playground-tab-bar-foreground-color: var(--pg-muted);
        --playground-tab-bar-active-color: var(--pg-fg);
        --playground-tab-bar-active-background: var(--pg-inset);
        --playground-tab-bar-font-size: 12px;
      }

      /* --- the view rail: an activity bar, full height ------------------------------------------------------- */
      .view-rail {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        width: 48px;
        padding: 6px 0;
        align-self: stretch;
        background: var(--pg-surface);
        border-radius: var(--pg-r-lg);
        box-shadow: var(--pg-shadow);
      }
      .view-rail button {
        position: relative;
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: var(--pg-r);
        background: transparent;
        color: var(--pg-faint);
        cursor: pointer;
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      .view-rail button:hover { color: var(--pg-fg-2); background: var(--pg-hover); }
      .view-rail button.is-active { color: var(--pg-fg); background: var(--pg-selected); }
      /* The active marker sits on the rail's edge, the way an activity bar marks the open view. */
      .view-rail button::before {
        content: '';
        position: absolute;
        left: -6px;
        top: 9px;
        bottom: 9px;
        width: 2px;
        border-radius: 0 2px 2px 0;
        background: var(--pg-accent);
        opacity: 0;
        transform: scaleY(0.4);
        transition: opacity var(--pg-med), transform var(--pg-med);
      }
      .view-rail button.is-active::before { opacity: 1; transform: none; }
      .view-rail button.is-active .material-symbols-outlined { font-variation-settings: 'FILL' 1; }

      /* --- panels ------------------------------------------------------------------------------------------- */
      .playground-app .pane {
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 0 16px 16px;
        background: var(--pg-surface);
        border-radius: var(--pg-r-lg);
        box-shadow: var(--pg-shadow);
        color: var(--pg-fg-2);
      }
      /* The panel title is a header row across the full panel, divided from the body by a hairline. */
      .playground-app .pane h2 {
        display: flex;
        align-items: center;
        height: 40px;
        margin: 0 -16px 12px;
        padding: 0 16px;
        box-shadow: inset 0 -1px 0 var(--pg-line);
        font: 600 11.5px/1 var(--pg-ui);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--pg-muted);
      }

      /* The code surfaces, all in the editor's face, size and rhythm. */
      .playground-app :is(#file-tree [role='treeitem'], #open-files [slot='tab'], .terminal, #files li) {
        font-family: var(--pg-mono);
        font-size: 13.5px;
        line-height: 1.7;
      }

      /* Material Symbols turns ligature text into an icon: without these mechanics the words show up as words. */
      .material-symbols-outlined {
        font-family: 'Material Symbols Outlined', sans-serif;
        font-weight: normal;
        font-style: normal;
        font-size: 20px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        display: inline-block;
        font-feature-settings: 'liga';
        font-variation-settings: 'FILL' 0, 'wght' 400, 'opsz' 20;
        -webkit-font-smoothing: antialiased;
      }

      /* --- the file tree -------------------------------------------------------------------------------------
         Padding 0 on the tree itself, so the tree, the tab strip and the editor start on one left edge.
         The tree is structure, the tab strip below it is open documents, and the two must not look alike: the tree
         is a vertical outline — full-width rows, a disclosure chevron on folders, children indented under a
         hairline guide — with no strip, no separators and no accent edge. Those belong to the tabs. */
      .playground-app #file-tree { display: block; padding: 0; margin: 0 0 12px; }
      /* A nested level: indented under its folder, the guide running down from the folder's chevron. */
      .playground-app #file-tree demo-tree {
        display: block;
        margin-left: 11px;
        padding-left: 4px;
        box-shadow: inset 1px 0 0 var(--pg-line);
      }
      .playground-app #file-tree [role='treeitem'] {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 26px;
        padding: 0 8px 0 4px;
        border-radius: var(--pg-r-sm);
        color: var(--pg-muted);
        cursor: pointer;
        user-select: none;
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      /* The chevron column: a disclosure on folders, an empty slot of the same width on files, so names align. */
      .playground-app #file-tree [role='treeitem']::before {
        content: '';
        flex: none;
        width: 16px;
        font: normal 16px/1 'Material Symbols Outlined';
        font-feature-settings: 'liga';
        letter-spacing: normal;
        text-transform: none;
        color: var(--pg-faint);
        transition: transform var(--pg-med);
      }
      .playground-app #file-tree [role='treeitem'][data-folder]::before { content: 'expand_more'; }
      .playground-app #file-tree [role='treeitem'][aria-expanded='false']::before { transform: rotate(-90deg); }
      .playground-app #file-tree [role='treeitem'][data-folder] { color: var(--pg-fg-2); }
      .playground-app #file-tree [role='treeitem']:hover { color: var(--pg-fg); background: var(--pg-hover); }
      /* The file that is open is marked in the tree too, so the tree and the tabs agree — as a quiet row
         highlight, not as a second selected tab. */
      .playground-app #file-tree [role='treeitem'][aria-current] { color: var(--pg-fg); background: var(--pg-hover); }
      .playground-app #file-tree [role='treeitem'] .material-symbols-outlined { font-size: 18px; color: var(--pg-faint); }
      .playground-app #file-tree [role='treeitem'][aria-current] .material-symbols-outlined { color: var(--pg-accent); }

      /* --- open files: a tab strip that sits on the editor ---------------------------------------------------
         Tabs scroll horizontally instead of wrapping, and the scroller is this page's own: Lion's tab group has no
         reachable shadow root (measured: `shadowRoot` null, host `display: block`), so its internals cannot be
         asked to scroll. The host grows to its content inside a scrolling wrapper, which works either way. */
      .tab-scroller {
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
        scrollbar-color: #3a3a42 transparent;
        background: var(--pg-strip);
        border-radius: var(--pg-r) var(--pg-r) 0 0;
        /* A hairline on all four sides; the selected tab paints over the bottom one with the editor's background,
           so the tab and the editor read as one sheet. */
        box-shadow: inset 0 1px 0 var(--pg-line), inset 1px 0 0 var(--pg-line), inset -1px 0 0 var(--pg-line),
          inset 0 -1px 0 var(--pg-line);
      }
      .tab-scroller::-webkit-scrollbar { height: 6px; }
      .tab-scroller::-webkit-scrollbar-thumb { background: #3a3a42; border-radius: 3px; }
      .playground-app #open-files { display: block; position: relative; z-index: 1; width: max-content; min-width: 100%; margin: 0; }
      .playground-app #open-files [slot='tab'] {
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 6px;
        height: 36px;
        padding: 0 6px 0 12px;
        white-space: nowrap;
        user-select: none;
        cursor: pointer;
        color: var(--pg-muted);
        background: transparent;
        box-shadow: inset -1px 0 0 var(--pg-line);
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      .playground-app #open-files [slot='tab']:first-child { border-top-left-radius: var(--pg-r); }
      .playground-app #open-files [slot='tab']:hover { color: var(--pg-fg-2); background: var(--pg-hover); }
      /* The active tab is the ARIA state this page owns (Lion does not decorate tabs it did not add), so the
         highlight follows `aria-selected`. It takes the editor's background, so tab and editor read as one sheet. */
      .playground-app #open-files [slot='tab'][aria-selected='true'] {
        color: var(--pg-fg);
        background: var(--pg-inset);
        box-shadow: inset 0 2px 0 var(--pg-accent), inset -1px 0 0 var(--pg-line);
      }
      .playground-app #open-files [slot='tab'].dragging { opacity: 0.4; }
      .playground-app #open-files [slot='tab'] > .material-symbols-outlined { font-size: 18px; color: var(--pg-faint); }
      .playground-app #open-files [slot='tab'] .close {
        display: grid;
        place-items: center;
        width: 20px;
        height: 20px;
        padding: 0;
        border: 0;
        border-radius: var(--pg-r-sm);
        background: transparent;
        color: var(--pg-muted);
        cursor: pointer;
        opacity: 0;
        transition: opacity var(--pg-fast), color var(--pg-fast), background-color var(--pg-fast);
      }
      .playground-app #open-files [slot='tab'] .close .material-symbols-outlined { font-size: 16px; }
      .playground-app #open-files [slot='tab']:is(:hover, [aria-selected='true']) .close,
      .playground-app #open-files [slot='tab'] .close:focus-visible { opacity: 1; }
      .playground-app #open-files [slot='tab'] .close:hover { color: var(--pg-fg); background: var(--pg-line-strong); }
      .playground-app #open-files [slot='tab']:focus-visible { outline-offset: -2px; }
      /* Lion's tabs require a panel per tab; the editor is the panel here, so the empty ones take no space. */
      #open-files [slot='panel'] { display: none !important; }

      /* --- the editor: fills what is left of the panel, so the panel never ends in dead space ----------------- */
      .playground-app #editor {
        display: block;
        flex: 1 0 30rem;
        min-height: 0;
        overflow: hidden;
        background: var(--pg-inset);
        border: 1px solid var(--pg-line);
        border-top: 0;
        border-radius: 0 0 var(--pg-r) var(--pg-r);
      }

      /* --- the run panel ------------------------------------------------------------------------------------- */
      /* The status is a row: a state dot and one line of text. The dot follows `data-state`, set by the script. */
      .playground-app .status {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 12px;
        font-size: 13px;
        line-height: 1.5;
        color: var(--pg-fg-2);
      }
      .playground-app #status::before {
        content: '';
        flex: none;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--pg-faint);
        transition: background-color var(--pg-med), box-shadow var(--pg-med);
      }
      .playground-app #status[data-state='running']::before { background: var(--pg-accent); box-shadow: 0 0 0 3px rgb(0 168 219 / 0.18); }
      .playground-app #status[data-state='ok']::before { background: var(--pg-ok); box-shadow: 0 0 0 3px rgb(51 255 204 / 0.14); }
      .playground-app #status[data-state='error']::before { background: var(--pg-error); box-shadow: 0 0 0 3px rgb(237 94 106 / 0.16); }

      .playground-app #busy { display: flex; align-items: center; gap: 8px; margin: -4px 0 12px; }
      .playground-app lion-progress-indicator { --lion-progress-indicator-size: 16px; }

      /* The preview is a light canvas inside dark chrome: the served document is somebody else's page and renders
         on white, and a transparent iframe shows the host through. It sits *in* the shell rather than glaring out of
         it: an off-white (#f3f3f4, the value the demos' shared styles.css paints too), a slightly stronger hairline
         edge than the dark wells get, and a soft inner shadow under the toolbar so the canvas reads as recessed. */
      /* No `display` here: the element's own `:host` is a flex column whose `#content` takes `flex: 1`, and that
         is what sizes the iframe to the frame. Forcing `display: block` (as this page used to) leaves the iframe at
         the browser's default 150px, and anything below that line in the canvas is cut off. */
      .playground-app #preview {
        position: relative;
        height: 18rem;
        overflow: hidden;
        background: #f3f3f4;
        /* padding-box: the border is a translucent hairline, and the light canvas under it would show as a halo. */
        background-clip: padding-box;
        border: 1px solid var(--pg-line-strong);
        border-radius: var(--pg-r);
      }
      /* Drawn over the iframe, below the toolbar, and never in the way of the pointer. */
      .playground-app #preview::after {
        content: '';
        position: absolute;
        inset: var(--playground-bar-height) 0 0;
        pointer-events: none;
        border-radius: 0 0 5px 5px;
        box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.14), inset 0 0 0 1px rgb(0 0 0 / 0.05);
      }
      #preview::part(preview-toolbar) { border-bottom: 1px solid var(--pg-line); font-family: var(--pg-ui); font-size: 12px; }
      #preview::part(preview-reload-button) { color: var(--pg-muted); transition: color var(--pg-fast); }
      #preview::part(preview-reload-button):hover { color: var(--pg-fg); }

      /* The console: an inset well. Empty, it says what will appear in it rather than being a blank box. */
      .playground-app .terminal {
        margin: 12px 0 0;
        padding: 10px 12px;
        min-height: 3rem;
        max-height: 16rem;
        overflow: auto;
        white-space: pre-wrap;
        background: var(--pg-inset);
        color: var(--pg-fg-2);
        border: 1px solid var(--pg-line);
        border-radius: var(--pg-r);
        scrollbar-width: thin;
        scrollbar-color: #3a3a42 transparent;
      }
      .playground-app .terminal:empty::before {
        content: 'Console output appears here when the program runs.';
        font-family: var(--pg-ui);
        font-size: 13px;
        color: var(--pg-faint);
      }
      /* The files the program wrote are the console's footer, in the same well: one box, one text column. */
      .playground-app .terminal:has(+ #files:not(:empty)) { border-radius: var(--pg-r) var(--pg-r) 0 0; }
      .playground-app #files {
        list-style: none;
        margin: 0;
        padding: 8px 12px 10px;
        background: var(--pg-inset);
        border: 1px solid var(--pg-line);
        border-top: 0;
        border-radius: 0 0 var(--pg-r) var(--pg-r);
      }
      .playground-app #files:empty { display: none; }
      .playground-app #files li { color: var(--pg-muted); }

      /* The checks disclosure is this page's own: Lion's accordion cannot be themed (see the markup comment). It is
         the same kind of well as the console above it — same surface, same hairline, same 12px inner edge — so its
         label and its content start on the console's text column instead of floating as a box of its own. */
      .playground-app .checks {
        margin: 12px 0 0;
        background: var(--pg-inset);
        border: 1px solid var(--pg-line);
        border-radius: var(--pg-r);
        font-size: 13px;
        color: var(--pg-fg-2);
      }
      .playground-app .checks summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 36px;
        padding: 0 10px 0 12px;
        border-radius: var(--pg-r);
        list-style: none;
        cursor: pointer;
        font: 600 11.5px/1 var(--pg-ui);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--pg-muted);
        transition: color var(--pg-fast), background-color var(--pg-fast);
      }
      .playground-app .checks summary::-webkit-details-marker { display: none; }
      .playground-app .checks summary:hover { color: var(--pg-fg-2); background: var(--pg-hover); }
      .playground-app .checks summary::after {
        content: 'expand_more';
        font: normal 18px/1 'Material Symbols Outlined';
        font-feature-settings: 'liga';
        letter-spacing: normal;
        text-transform: none;
        transition: transform var(--pg-med);
      }
      .playground-app .checks[open] summary::after { transform: rotate(180deg); }
      .playground-app .checks[open] summary { border-radius: var(--pg-r) var(--pg-r) 0 0; box-shadow: inset 0 -1px 0 var(--pg-line); }
      .playground-app .checks > :not(summary) { margin-left: 12px; margin-right: 12px; }
      .playground-app .checks > p:first-of-type { margin-top: 12px; }
      .playground-app .checks > :last-child { margin-bottom: 12px; }
      .playground-app .checks .status { display: block; margin-bottom: 8px; font-size: 13px; }
      .playground-app #governance[data-consistent='false'] { color: var(--pg-error); }
      .playground-app .checks h3 {
        margin-top: 16px;
        margin-bottom: 8px;
        font: 600 11.5px/1 var(--pg-ui);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--pg-muted);
      }
      .playground-app #findings { margin-top: 0; margin-bottom: 8px; padding-left: 0; list-style: none; font-family: var(--pg-mono); font-size: 12.5px; color: var(--pg-muted); }
      .playground-app #packages { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 0; margin-bottom: 0; padding: 0; list-style: none; }
      .playground-app #packages li {
        padding: 1px 6px;
        border-radius: var(--pg-r-sm);
        background: var(--pg-hover);
        font-family: var(--pg-mono);
        font-size: 12px;
        color: var(--pg-fg-2);
      }
      .playground-app .checks .note { margin-top: 12px; }

      .playground-app .note { margin: 12px 0 0; max-width: 68ch; font-size: 13px; line-height: 1.6; color: var(--pg-muted); }
      .playground-app code { font-family: var(--pg-mono); font-size: 12.5px; color: #ce9178; }

      /* --- the view model -------------------------------------------------------------------------------------
         One attribute on <body>, driven by the rail on a desktop and the bottom bar on a phone; show/hide lives
         here so there is one source of truth. `files` is the full layout — the rail switches focus, not the editor
         out of existence, which is how an activity bar behaves. `code` is that view with the tree folded away, and
         the last two are the run pane alone. */
      body[data-view='code'] #file-tree,
      body[data-view='code'] #pane-run { display: none; }
      body[data-view='preview'] #pane-project,
      body[data-view='output'] #pane-project { display: none; }
      body[data-view='preview'] #node-panes,
      body[data-view='preview'] .checks,
      body[data-view='preview'] #mode-note { display: none; }
      body[data-view='output'] #preview { display: none; }
      /* A focused view gets the whole width beside the rail, not a narrow column. */
      body[data-view='preview'] #pane-run,
      body[data-view='output'] #pane-run { grid-column: 2 / -1; }
      /* With the preview gone, the console is the view: it starts at the top of the panel. */
      body[data-view='output'] .playground-app .terminal { margin-top: 0; }

      .mobile-tabs { display: none; }

      /* --- a phone: one view at a time, switched from a fixed bar at the bottom ------------------------------- */
      @media (max-width: 48rem) {
        /* 48px header + 12px on top; the 57px bar + 27px underneath, so the last line is never under the bar. */
        main { padding: 60px 16px 84px; }
        main > header h1 { font-size: 18px; }
        main > header .lede { display: none; }

        .toolbar.playground-app { display: block; }
        #modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; }
        #modes [role='tab'] { justify-content: center; height: 40px; line-height: 40px; padding: 0 8px; }
        #modes .mode-hint { display: none; }

        .playground.playground-app { grid-template-columns: minmax(0, 1fr); gap: 12px; }
        .view-rail { display: none; }
        /* The focused views span "column 2 to the end" beside the rail; with no rail and one column that would
           invent an implicit second column and push the run pane off to the right. */
        body[data-view] #pane-run { grid-column: auto; }

        .playground-app .pane { padding: 0 12px 12px; }
        .playground-app .pane h2 { margin: 0 -12px 12px; padding: 0 12px; }
        /* The editor takes the rest of the screen above the bar (never less than 22rem), so the code view is the
           whole phone rather than a box with empty page beneath it. */
        .playground-app #editor { flex-basis: max(22rem, calc(100dvh - 360px)); }
        .playground-app #preview { height: 22rem; }

        /* Phone-sized hit areas, and a tree that does not eat the editor: it scrolls inside a capped height. */
        .playground-app #file-tree { max-height: 9rem; overflow: auto; }
        .playground-app #file-tree [role='treeitem'] { height: 40px; }
        .playground-app #open-files [slot='tab'] { height: 40px; }
        .playground-app #open-files [slot='tab'] .close { width: 28px; height: 28px; opacity: 1; }

        /* The bar: fixed, safe-area aware, four views in four columns, 56px touch targets plus its hairline. */
        .mobile-tabs {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 20;
          font-family: var(--pg-ui);
          background: var(--pg-chrome);
          border-top: 1px solid var(--pg-line);
          padding-bottom: env(safe-area-inset-bottom, 0);
        }
        .mobile-tabs button {
          position: relative;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 3px;
          min-height: 56px;
          padding: 6px 0;
          border: 0;
          background: transparent;
          color: var(--pg-muted);
          font: 500 11px/1.2 var(--pg-ui);
          letter-spacing: 0.01em;
          cursor: pointer;
          -webkit-tap-highlight-color: transparent;
          transition: color var(--pg-fast), background-color var(--pg-fast);
        }
        .mobile-tabs button .material-symbols-outlined { font-size: 22px; }
        .mobile-tabs button.is-active { color: var(--pg-fg); }
        .mobile-tabs button.is-active .material-symbols-outlined { color: var(--pg-accent); font-variation-settings: 'FILL' 1; }
        .mobile-tabs button::before {
          content: '';
          position: absolute;
          top: -1px;
          left: 50%;
          width: 24px;
          height: 2px;
          margin-left: -12px;
          border-radius: 0 0 2px 2px;
          background: var(--pg-accent);
          opacity: 0;
          transition: opacity var(--pg-med);
        }
        .mobile-tabs button.is-active::before { opacity: 1; }
        .mobile-tabs button:active { background: var(--pg-hover); }
        .mobile-tabs button:focus-visible { outline-offset: -4px; }
      }

      /* On a touch screen there is no hover to reveal a tab's close button, so it is always there. */
      @media (hover: none) {
        .playground-app #open-files [slot='tab'] .close { opacity: 1; }
      }

      @media (prefers-reduced-motion: reduce) {
        .playground-app *,
        .playground-app *::before,
        .playground-app *::after,
        .mobile-tabs *,
        .mobile-tabs *::before { transition: none !important; }
      }
    </style>
  </body>
</html>

  {
    source: 'lion-node-demo-runner-governance',
    origin: location.origin,
    controlled: Boolean(navigator.serviceWorker.controller),
    policy,
    eval: evalOutcome,
    crossOrigin: crossOriginOutcome,
  },
  '*',
);


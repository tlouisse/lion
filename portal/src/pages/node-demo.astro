         the one thing left that still reads as two documents stapled together. */
      main > header {
        background: #141416; border: 1px solid #2a2a30; border-radius: 16px;
        padding: 20px; margin: 0 0 16px; text-align: left;
      }
      main > header h1 { margin: 0 0 6px; font-weight: 500; letter-spacing: -0.01em; color: #f2f2f2; }
      main > header .lede { margin: 0; }

      /* The preview canvas, softened off pure white so it sits inside the dark shell instead of punching a hole
         through it. The served document paints the same value, so the canvas and its content agree. */
      .playground-app #preview { background: #f7f7f8; }

      /* One radius scale, borrowed from runware: 16 for the containers, 8 for the boxes inside them, 6 for
         controls. Mixed radii are what makes an interface look assembled rather than designed. */
      .playground-app .terminal,
      .playground-app #output,
      .playground-app #preview,
      .playground-app #editor,
      .playground-app .checks { border-radius: 8px; }
      /* The scrollbars this page owns, not the browser's. */
      .playground-app .terminal,
      .tab-scroller { scrollbar-width: thin; scrollbar-color: #3a3a42 transparent; }
      /* Inactive labels a step brighter: on #1b1b1e the old values sat too close to the background. */
      .playground-app #open-files [slot='tab'] { color: #a8a8b0; }
      .playground-app #open-files [slot='tab'] .close { color: #9aa0a6; }
      .playground-app #file-tree [role='treeitem'] { color: #c3c3cb; padding: 0.2rem 0.35rem; }
      .playground-app #files li { color: #9aa0a6; }
      /* The status reads as a status row: label, state, indicator on one line. */
      .playground-app #busy { display: flex; align-items: center; gap: 8px; margin: -4px 0 8px; }
      .playground-app lion-progress-indicator { --lion-progress-indicator-size: 18px; }
      /* The checks disclosure: a quiet row with a caret, not a heavy box. */
      .playground-app .checks { border-width: 1px; }
      .playground-app .checks summary { list-style: none; }
      .playground-app .checks summary::after { content: '⌄'; float: right; opacity: 0.6; }
      .playground-app .checks[open] summary::after { content: '⌃'; }

      /* --- CodeSandbox's mobile shape -------------------------------------------------------------------------
         Measured on their interface: the UI runs on Inter and draws its icons from Material Symbols Outlined, so
         both are loaded and the glyphs are the real ones. The shell is one view at a time, switched from a fixed
         bar at the bottom, with 44px touch targets — what a phone-width editor needs and what this page did not
         have. The view is one attribute on <body>; no show/hide logic is duplicated in script. */
      main,
      .playground-app,
      .mobile-tabs { font-family: Inter, system-ui, sans-serif; }

      /* Material Symbols turns ligature text into an icon: without these mechanics the words show up as words. */
      .material-symbols-outlined {
        font-family: 'Material Symbols Outlined', sans-serif;
        font-weight: normal;
        font-style: normal;
        font-size: 20px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        display: inline-block;
        font-feature-settings: 'liga';
        -webkit-font-smoothing: antialiased;
      }

      .mobile-tabs { display: none; }

      /* --- the view rail, and the editors' font ---------------------------------------------------------------
         The icons switch what the app shows, the way an activity bar does, and the same view model runs at every
         width: the rail on a desktop, the bottom bar on a phone, one `<body>` attribute underneath. */
      .playground-app { grid-template-columns: auto minmax(0, 1.1fr) minmax(0, 1fr); }
      .view-rail {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        width: 44px;
        padding: 8px 0;
        /* Full height, the way an activity bar spans its window rather than floating as a pill beside it. */
        align-self: stretch;
        background: #141416;
        border: 1px solid #2a2a30;
        border-radius: 16px;
      }
      .view-rail button {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #8b8b95;
        cursor: pointer;
      }
      .view-rail button:hover { color: #f2f2f2; background: #1b1b1e; }
      .view-rail button.is-active { color: #1389fd; background: #1b1b1e; }
      .view-rail button .material-symbols-outlined { font-size: 20px; }

      /* The view rules, at every width. `files` is the full layout — the rail switches focus, not the editor out of
         existence, which is how an activity bar behaves and the only sane default for a playground: open it and the
         code is there. `code` is that same view with the tree folded away, and the last two are the run pane alone. */
      body[data-view='code'] #file-tree,
      body[data-view='code'] #pane-run { display: none; }
      body[data-view='preview'] #pane-project,
      body[data-view='output'] #pane-project { display: none; }
      body[data-view='preview'] #node-panes,
      body[data-view='preview'] .checks,
      body[data-view='preview'] #mode-note { display: none; }
      body[data-view='output'] #preview { display: none; }
      /* A focused view gets the whole width beside the rail, not a narrow column. */
      body[data-view='preview'] #pane-run,
      body[data-view='output'] #pane-run { grid-column: 2 / -1; }

      /* The editors, exactly as runware's: their <pre> measures JetBrains Mono at 13.5px on a 1.8 line-height, and
         the console reads in the same face — which is what was asked for. */
      .playground-app {
        --playground-code-font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        --playground-code-font-size: 13.5px;
        --playground-code-line-height: 1.7;
      }
      .playground-app .terminal,
      .playground-app #files li,
      .playground-app #file-tree [role='treeitem'],
      .playground-app #open-files [slot='tab'] {
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      .playground-app .terminal { font-size: 13px; line-height: 1.7; }

      /* File-type icons in the tree and the tabs, from the same set as the bar. */
      .playground-app #file-tree [role='treeitem'],
      .playground-app #open-files [slot='tab'] { display: inline-flex; align-items: center; gap: 6px; }
      .playground-app #file-tree [role='treeitem'] .material-symbols-outlined,
      .playground-app #open-files [slot='tab'] .material-symbols-outlined { font-size: 16px; color: #8b8b95; }

      @media (max-width: 48rem) {
        main { padding: 12px 12px 84px; padding-top: 60px; }
        main > header { padding: 14px 16px; border-radius: 12px; }
        main > header .lede { display: none; }
        .playground-app .playground,
        .playground.playground-app { grid-template-columns: 1fr; gap: 12px; }
        .playground-app .toolbar,
        .toolbar.playground-app { min-height: 0; padding: 10px 12px; border-radius: 12px; }
        /* The mode buttons wrap on a phone — nothing cut off. Horizontal scrolling belongs to the file tabs, which
           is what it was asked for; a control that is half off-screen reads as broken. */
        .playground-app #modes { flex-wrap: wrap; overflow-x: visible; }
        .playground-app #modes [role='tab'] { min-height: 40px; white-space: normal; }
        .playground-app .pane { border-radius: 12px; padding: 14px; }
        .playground-app #editor { height: 22rem; }
        .playground-app #preview { height: 22rem; }

        /* One view at a time; the rail is replaced by the bar at this width. */
        .view-rail { display: none; }

        /* The bar: fixed, safe-area aware, one icon and one word per view. */
        .mobile-tabs {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          position: fixed;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 20;
          background: #141416;
          border-top: 1px solid #2a2a30;
          padding-bottom: env(safe-area-inset-bottom, 0);
        }
        .mobile-tabs button {
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 2px;
          min-height: 56px;
          padding: 6px 0;
          border: none;
          background: transparent;
          color: #9aa0a6;
          font: inherit;
          font-size: 11px;
          cursor: pointer;
        }
        .mobile-tabs button .material-symbols-outlined { font-size: 22px; }
        .mobile-tabs button.is-active { color: #1389fd; }
        .mobile-tabs button:active { background: #1b1b1e; }

        /* Phone-sized hit areas, and a tree that does not eat the editor: it scrolls inside a capped height, since
           a phone shows one view at a time and the code is what it is showing. */
        .playground-app #file-tree { max-height: 9rem; overflow: auto; }
        .playground-app #file-tree [role='treeitem'] { min-height: 40px; font-size: 13px; }
        .playground-app #open-files [slot='tab'] { min-height: 40px; }
        .playground-app #open-files [slot='tab'] .close { min-width: 28px; min-height: 28px; font-size: 16px; }
      }
      /* Breathing room, and one left edge for everything in the run pane. */
      .playground-app .pane h2 { margin-bottom: 0.6rem; padding-bottom: 0.35rem; }
      .playground-app .lede { margin-bottom: 1.25rem; }
      /* The tree's own padding goes to zero so its rows start on the same x as the tabs above them — measured 113 vs
         116.2 with the 0.2rem it carried. The margin below it stays the 8px that separates the two. */
      .playground-app #file-tree { padding: 0; margin-bottom: 8px; }
      .playground-app #file-tree [role='treeitem'] { padding: 0.15rem 0.35rem; }
      .playground-app #open-files { margin-bottom: 0; }
      .playground-app #files { padding-left: 1.1rem; margin-top: 0; }

      /* One toolbar rule, px only: two blocks were both claiming this element and rem values won by order
         (measured paddingTop 8.8px against the panels' 20px). */
      .playground-app .toolbar,
      .toolbar.playground-app {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 52px;
        padding: 0 20px;
        margin-bottom: 16px;
        background: #1b1b1e;
        border: 1px solid #2a2a30;
        border-radius: 16px;
      }
      .playground-app #modes [role='tab'] { color: #b9b9c0; border-color: #3a3a42; }
      .playground-app #modes [role='tab'][aria-selected='true'] {
        background: #1389fd; border-color: #1389fd; color: #fff;
      }
      html[data-theme='dark'] .toolbar.playground-app { border-color: #2a2a30; }
      .terminal {
        margin: 0 0 0.75rem; padding: 0.5rem 0.75rem; min-height: 3rem; max-height: 16rem;
        overflow: auto; white-space: pre-wrap; background: #101014; color: #eaeaea;
        border-radius: 4px; font-family: Menlo, Cascadia Code, Consolas, Liberation Mono, monospace;
        font-size: 0.8rem; line-height: 1.35;
      }
      pre, ul, code, .status { font-size: 0.8rem; }
      ul { margin: 0 0 0.75rem; padding-left: 1.1rem; }
      .status { margin: 0 0 0.5rem; }
      .note { color: #555; font-size: 0.85rem; max-width: 64ch; }
      #busy { margin: 0 0 0.5rem; }
      [hidden] { display: none !important; }

      /* Dark mode is the portal's own mechanism — data-theme on <html>, mapped here the way theme.css does it. */
      html[data-theme='dark'] { color-scheme: dark; }
      html[data-theme='dark'] main { color: #ececec; }
      html[data-theme='dark'] .lede,
      html[data-theme='dark'] .note,
      html[data-theme='dark'] .pane h2 { color: #a8a8a8; }
      html[data-theme='dark'] .pane h2 { border-bottom-color: #3a3a3a; }
      html[data-theme='dark'] #ide { border-color: #3a3a3a; }
      html[data-theme='dark'] #modes [role='tab'] { border-color: #6a6a6a; }
      html[data-theme='dark'] #modes [role='tab'][aria-selected='true'] {
        background: #ececec; color: #16161a; border-color: #ececec;
      }
      /* The app surface is dark in both themes, so the header's switch must not lighten its panels. */
      .playground-app .pane h2,
      .playground-app .status,
      .playground-app .note { color: #9aa0a6; }
      .playground-app #editor { border-color: #2a2a30; background: #141416; }
    </style>
  </body>
</html>

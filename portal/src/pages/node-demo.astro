            load(`${assetsBase}importMapPerPackage.js`).then(module => module.default),
            load(`${assetsBase}packageMains.js`).then(module => module.default),
            load(`${assetsBase}host.js`),
            load(`${assetsBase}checkDemoContent.js`).then(module => (assets = { ...assets, ...module })).catch(() => {}),

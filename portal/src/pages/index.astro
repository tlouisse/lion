---
// The hero's drawing, inlined so it inherits currentColor and follows the theme like any other text.
import heroGraphic from '../../public/hero-user-interfaces.svg?raw';
import HomeLayout from "../layouts/HomeLayout.astro";
import { getEntry } from "astro:content";

// Same convention as TopNav: BASE_URL without its trailing slash, so the headline's door links
// resolve to /fundamentals/... on a root build and /lion/fundamentals/... under a base.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const entry = await getEntry('lionIndex', 'index');

const {
  title,
  slogan,
  callToActionItems,
} = entry.data;
---

<HomeLayout title={title}>
  <section class="hero">
      <div class="blueprint-bg">
              <!--
                The hero's drawing: user interfaces as a technical blueprint, inlined with ?raw so it inherits
                currentColor and follows the theme like any other text. It was drawn by Opus 5.5 from a brief that
                fixed the constraints in advance — one self-contained SVG, opaque strokes only, no opacity, filter,
                gradient, mask, script or colour literal, so the page owns the tone and the file is honest ink.
                Verified independently: 82 elements, viewBox 0 0 1200 800, 78 currentColor, 0 of every forbidden
                construct, strokes only 0.5/1/1.5 with round caps.
              -->
              <Fragment set:html={heroGraphic} />
          </div>
      <div class="container">
          <div class="hero-content">
              <!--
                    aria-label because the picker's listbox lives inside this heading: an accessible name is taken from the
                    heading's contents, so without this a screen reader would announce the whole option list as part of the
                    heading. The label is the sentence as it is meant to be read.
                -->
              <h1 class="hero-headline" aria-label="Robust. Flexible. User Interfaces. Everywhere.">
                  <!--
                    Every word is a door. The three plain words are anchors to the sections below, so the headline scrolls the
                    page to what it promises; Flexible. is the theme picker instead, because it opens rather than navigates. The
                    aria-label is explicit: an accessible name comes from a heading's contents, and the picker's listbox lives
                    inside this one, so without it a screen reader would read the whole option list as part of the heading.
                  -->
                  <a class="hero-pill" href="#robust">Robust.</a><br><span class="theme-picker">
                      <button type="button" id="theme-picker-trigger" class="theme-picker__trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="theme-picker-label">
                          <span id="theme-picker-label" class="theme-picker__value">Flexible.</span>
                          <svg class="theme-picker__caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                      <!--
                        The theme list is a modal dialog rather than a dropdown inside the headline. Reason, measured: the
                        headline carries a scroll animation (filter: blur(0)) and .hero-content a transform, and both create a
                        containing block — so a fixed element here anchored to the h1, not the viewport, and a bottom sheet
                        came out the size of the heading. A modal dialog is promoted to the top layer and escapes all of
                        that, and ::backdrop, Escape and focus handling come with it.
                        On a phone it is a bottom sheet; on a wider screen the script places it under the word.
                      -->
                      <dialog class="theme-picker__sheet" id="theme-picker-list" aria-labelledby="theme-picker-label">
                          <ul class="theme-picker__options" role="listbox" aria-labelledby="theme-picker-label">
                              <li role="option" class="theme-picker__option" id="theme-option-lion" data-theme-id="lion" aria-selected="true">Lion <span class="theme-picker__hint">the design system</span></li>
                              <li role="option" class="theme-picker__option" id="theme-option-material" data-theme-id="material" aria-selected="false">Material <span class="theme-picker__hint">Material Design 3</span></li>
                              <li role="option" class="theme-picker__option" id="theme-option-shoelace" data-theme-id="shoelace" aria-selected="false">Shoelace <span class="theme-picker__hint">web components</span></li>
                              <li role="option" class="theme-picker__option" id="theme-option-baseui" data-theme-id="baseui" aria-selected="false">Base UI <span class="theme-picker__hint">unstyled primitives</span></li>
                          </ul>
                      </dialog>
                  </span><br><a class="hero-pill" href="#user-interfaces">User Interfaces.</a><br><br><a class="hero-pill" href="#everywhere">Everywhere.</a>
              </h1>
              <p class="hero-subtitle">{slogan}</p>
              <div class="cta-group">
                  {callToActionItems.map((callToAction, index) => (
                      <a href={callToAction.href} class={index === 0 ? "btn btn-primary" : "btn btn-secondary"}>
                          {callToAction.text} {index === 0 && <span class="arrow">→</span>}
                      </a>
                  ))}
              </div>
          </div>
      </div>
  </section>

  <!--
    Four sections, one per word in the headline, replacing the old "Why Lion?" grid. The words in the hero are the doors
    and these are what they lead to; each has its own background so the page reads as four chapters rather than one list.
    The copy is the brief's own: headless before the term existed and seven years of hardening for Flexible; a11y, tests,
    consuming projects and performance for Robust; systems, primitives and components for User Interfaces; web components
    and framework-agnostic controllers for Everywhere.
  -->
  <section class="term term--robust" id="robust">
      <div class="container">
          <p class="term__eyebrow scroll-animate">Robust.</p>
          <h2 class="scroll-animate-blur">Tested against the platform, not this year&#39;s framework.</h2>
          <ul class="term__points scroll-animate">
              <li><strong>No framework lock-in.</strong> Primitives and components built on the platform itself, so they outlive whichever framework is fashionable at the moment.</li>
              <li><strong>Built to grow with the platform.</strong> Made to adopt what browsers ship as they ship it, with fallbacks for every browser we support.</li>
              <li><strong>Small by default.</strong> Built on Lit and the platform, with nothing heavier between your application and the browser.</li>
              <li><strong>Accessibility as a contract.</strong> 26 of the 42 components carry an automated accessibility check today, and the behaviour is verified in three browser engines.</li>
              <li><strong>Proven in production.</strong> Built by UI and accessibility specialists and used across ING&#39;s applications, so regressions surface early and loudly.</li>
          </ul>
          <a class="term__link scroll-animate" href={`${base}/fundamentals/rationales/`}>How we engineer it →</a>
      </div>
  </section>

  <section class="term term--flexible" id="flexible">
      <div class="container">
          <p class="term__eyebrow scroll-animate">Flexible.</p>
          <h2 class="scroll-animate-blur">White-label from the first commit.</h2>
          <p class="term__lede scroll-animate">Seven years of hardening behind accessible abstractions you style yourself.</p>
          <ul class="term__points scroll-animate">
              <li><strong>More than theming.</strong> Not a palette swap: the components ship without a visual identity, so yours is the only one they carry.</li>
              <li><strong>It fits what you already have.</strong> Other CSS libraries, your own design system, a legacy application: Lion slots in beside them.</li>
          </ul>
          <a class="term__link scroll-animate" href={`${base}/fundamentals/systems/`}>The systems underneath →</a>
      </div>
  </section>

  <section class="term term--interfaces" id="user-interfaces">
      <div class="container">
          <p class="term__eyebrow scroll-animate">User Interfaces.</p>
          <h2 class="scroll-animate-blur">Systems, primitives and components.</h2>
          <p class="term__lede scroll-animate">Three levels: start from a system for behaviour, a primitive for control, a component to ship.</p>
          <ul class="term__points scroll-animate">
              <li><strong>Systems.</strong> The behaviour that is hard to get right — forms, overlays, localisation, validation.</li>
              <li><strong>Primitives.</strong> Mixins and base classes those systems are built from, usable on their own.</li>
              <li><strong>Components.</strong> The finished controls, accessible and styled, ready to drop in.</li>
          </ul>
          <a class="term__link scroll-animate" href={`${base}/components/`}>Browse components →</a>
      </div>
  </section>

  <!--
    The page used to end on the last section and then the footer, so a reader who had come all the way down had
    nothing to click. This is the closing step, and it repeats the one action the page is asking for.
  -->
  <section class="term term--cta" id="start">
      <div class="container">
          <h2 class="scroll-animate-blur">Start with a component, or read how the systems fit together.</h2>
          <p class="term__points scroll-animate">
              <a class="hero-pill" href={`${base}/components/`}>Get started →</a>
              <a class="hero-pill" href={`${base}/fundamentals/systems/`}>The systems underneath</a>
          </p>
      </div>
  </section>

  <section class="term term--everywhere" id="everywhere">
      <div class="container">
          <p class="term__eyebrow scroll-animate">Everywhere.</p>
          <h2 class="scroll-animate-blur">Framework agnostic, by construction.</h2>
          <p class="term__lede scroll-animate">Web components and framework-agnostic controllers: the behaviour does not belong to a framework, so it does not leave with one.</p>
          <ul class="term__points scroll-animate">
              <li><strong>Web components.</strong> The components are custom elements, so any framework that renders HTML can use them.</li>
              <li><strong>Framework-agnostic controllers.</strong> The logic underneath is reusable without the element, for teams writing their own rendering layer.</li>
          </ul>
          <a class="term__link scroll-animate" href={`${base}/guides/principles/`}>The principles →</a>
      </div>
  </section>
</HomeLayout>

<script>
  /*
   * The headline's theme picker. A listbox in the APG sense: a button that opens a list of options, closed by Escape or a
   * click outside, walkable with the arrow keys. Choosing one stores it globally — data-demo-theme on <html> plus
   * localStorage — so a later skin can read one value per document.
   *
   * The label in the headline stays "Flexible." because that is the sentence it belongs to; the choice is shown in the
   * list itself (aria-selected on the option) and, for anything that reads it, on the document.
   *
   * Deliberately not data-theme: that is the light/dark choice, written by ThemeInit, and this must not fight it.
   */
  const KEY = 'lion-portal-demo-theme';
  const trigger = document.getElementById('theme-picker-trigger');
  const list = document.getElementById('theme-picker-list');

  if (trigger && list) {
    const options = [...list.querySelectorAll('[role="option"]')];
    const read = () => {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    };
    const write = id => {
      try {
        localStorage.setItem(KEY, id);
      } catch {
        /* the theme is a comfort setting, not a requirement */
      }
    };
    // Under the word on a wide screen; on a phone the stylesheet makes it a bottom sheet, where position does not matter.
    const place = () => {
      if (window.matchMedia('(max-width: 1023px)').matches) {
        return;
      }
      const rect = trigger.getBoundingClientRect();
      const sheet = list.getBoundingClientRect();
      const left = Math.min(rect.left, window.innerWidth - sheet.width - 16);
      list.style.left = `${Math.max(16, left)}px`;
      list.style.top = `${rect.bottom + 8}px`;
    };
    const open = expanded => {
      trigger.setAttribute('aria-expanded', String(expanded));
      if (expanded) {
        if (!list.open) list.showModal();
        place();
        options.find(option => option.getAttribute('aria-selected') === 'true')?.focus();
      } else if (list.open) {
        list.close();
      }
    };
    const select = (id, { moveFocus = true } = {}) => {
      document.documentElement.dataset.demoTheme = id;
      write(id);
      options.forEach(option => option.setAttribute('aria-selected', String(option.dataset.themeId === id)));
      open(false);
      // Only when a person picked it: the initial call must not focus the trigger, or it would render in its
      // focus-visible state on every page load (measured as a 12% fill against the resting 7%).
      if (moveFocus) trigger.focus();
    };

    // The stored choice wins; without one the markup's own default (Lion) stands.
    const stored = read();
    select(options.some(option => option.dataset.themeId === stored) ? stored : 'lion', { moveFocus: false });

    trigger.addEventListener('click', () => open(!list.open));
    options.forEach((option, index) => {
      option.tabIndex = -1;
      option.addEventListener('click', () => select(option.dataset.themeId));
      option.addEventListener('keydown', event => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          select(option.dataset.themeId);
        } else if (event.key === 'ArrowDown') {
          event.preventDefault();
          options[(index + 1) % options.length].focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          options[(index - 1 + options.length) % options.length].focus();
        }
      });
    });
    trigger.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open(true);
      } else if (event.key === 'Escape') {
        open(false);
      }
    });
    // A modal dialog closes itself on Escape; these two keep the trigger's state honest for any other dismissal.
    list.addEventListener('close', () => {
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    });
    list.addEventListener('click', event => {
      // The dialog element itself is the area outside the listbox: a tap there is a dismissal.
      if (event.target === list) open(false);
    });
    window.addEventListener('resize', () => {
      if (list.open) place();
    });
  }
</script>

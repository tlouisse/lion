---
import { getCollection } from "astro:content";
// import { UIPortalMainNav } from './ui-portal-main-nav.js';
import { UIMainNav as UIPortalMainNav } from './UIMainNav/ui-main-nav.js';

import SearchModal from './SearchModal.astro';
import LionWordmark from '../components/LionWordmark.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Props {
  variant?: string;
}

async function buildCollectionTree(collectionName, filter) {
  const entries = await getCollection(collectionName, filter);
  const entriesSortedByLevel = entries
    .map((entry) => {
      const level = entry.id.split('/').length;
      return { ...entry, level };
    })
    .sort((a, b) => a.level - b.level);
  const navigationMap = { children: [] };

  for (const entry of entriesSortedByLevel) {
    if (entry.id === 'index' || entry.id.endsWith('/index')) {
      // Skip index pages, as they are represented as folders
      continue;
    }

    navigationMap[entry.id] = { entry, children: [] };
    const parentUrl = entry.id.split('/').slice(0, -1).join('/');
    if (navigationMap[parentUrl]) {
      navigationMap[parentUrl].children.push(navigationMap[entry.id]);
    } else {
      navigationMap.children.push(navigationMap[entry.id]);
    }

  }

  return navigationMap.children;
}

function convertCollectionTreeToNavigation(collectionTree, baseUrl = '/', isSortedAlphabetically = true) {
  const navigation = [];
  collectionTree.forEach((collectionNode) => {
    const { entry, children } = collectionNode;
    const navigationNode = {
      name: entry.data?.eleventyNavigation?.title || entry.id,
      url: [baseUrl, entry.id].join('/'),
      priority: entry.data?.eleventyNavigation?.order || 0,
    };

    if (children.length > 0) {
      navigationNode.children = convertCollectionTreeToNavigation(children, baseUrl, false);
    }

    navigation.push(navigationNode);
  });

  if (isSortedAlphabetically) {
    navigation.sort((a, b) => a.name.localeCompare(b.name));
  } else {
    // Sort child items by priority
    navigation.sort((a, b) => a.priority - b.priority);
  }

  // if page has a child, we sent to the first child
  // this preserves the logic of the previous implementation
  // see @rocket/navigation@0.2.1 /src/RocketNavigation.js
  navigation.forEach((navigationNode) => {
    if (navigationNode.children?.length > 0) {
      navigationNode.redirect = navigationNode.children[0].redirect || navigationNode.children[0].url; // Set the URL to the first child's URL
    }
  });

  return navigation;
}

/**
 * The nav renders nested levels from `nextLevel` (see UIMainNav), and an item that has it is
 * expandable. The collection tree is deeper than a fly-out can carry - a components subtree alone is
 * a whole documentation tree - so the menu stops after a few levels.
 *
 * It used to stop one level earlier, which left real pages without a row: "Core" could not open
 * (its /overview, /slotmixin children were cut), so a page you can only reach through the menu was
 * not in the menu. Two levels below the top items now, which is what "all pages" needs - the deepest
 * rows are the leaf pages themselves.
 */
const MAX_DEPTH = 2;

function pruneDeeperThan(nodes, depth = 0) {
  for (const node of nodes) {
    if (!node.children?.length) continue;
    if (depth >= MAX_DEPTH) {
      delete node.children;
      continue;
    }
    pruneDeeperThan(node.children, depth + 1);
  }

  return nodes;
}

const slug = value =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

/**
 * `children` is what the server side uses to mark the active trail; `nextLevel` is what the
 * component renders and what makes an item a toggle. The key keeps the popover ids unique - one
 * level 2 panel per parent, and a popovertarget can only address one id.
 */
function toNavLevels(items, { topLevelLinksUnderneath = true } = {}) {
  return items.map(item => {
    const children = item.children || [];
    const node = { ...item };
    delete node.children;

    /*
     * A sub-section's own page is an empty shell: /fundamentals/systems renders a heading and no
     * content (measured: 943 characters of inline CSS and no prose, against 3970 characters on
     * /fundamentals/systems/core/overview), because the collection puts the content on the first
     * child. `redirect` from the collection tree is exactly that first child, so a row that has a
     * level links to it and the link lands on a page with something on it.
     *
     * Only below the top level: /fundamentals, /guides and /blog are real pages of their own. It
     * applies to a row whether or not it has a level of its own - "Systems" (a folder) and "Core" (a
     * leaf in the pruned tree, but its collection node still knows its first child) both land on a page
     * with content this way.
     */
    if (!topLevelLinksUnderneath && item.redirect) {
      node.url = item.redirect;
    }

    if (children.length) {
      node.nextLevel = {
        key: slug(item.name),
        // Nested levels are disclosures: they expand *downward* inside the fly-out instead of
        // opening another full-height panel. Level 1 is the panel (the component opens it with
        // mode 'popover'); its children are inline.
        items: toNavLevels(children, { topLevelLinksUnderneath: false }),
      };

      /*
       * A top-level row is a toggle, not a link: the section's own page moves into the level as its
       * first entry ("overview"), so the link is one tap away - underneath, where the menu is read.
       * It is done here, at build time, and not in the mobile layout's processor: a transformation
       * that only runs on the client gives the same item two different shapes in the server and the
       * client render, and the parts that differ get new elements on hydration - which is what left
       * the level toggles bound to elements that were no longer in the document.
       *
       * The desktop processor takes the link back (its rows are flat links), and `overview: true` is
       * what marks the entry it moved.
       */
      if (topLevelLinksUnderneath && node.url) {
        node.nextLevel.items = [
          { name: 'overview', url: node.url, overview: true },
          ...node.nextLevel.items,
        ];
        delete node.url;
      }
    }
    return node;
  });
}

async function getNavigation(collectionName, baseUrl = '/', isSortedAlphabetically = true, filter = () => true) {
  const collectionTree = await buildCollectionTree(collectionName, filter);
  const navigation = convertCollectionTreeToNavigation(collectionTree, baseUrl, isSortedAlphabetically);

  return pruneDeeperThan(navigation);
}

const components = await getNavigation(
  "lionComponents",
  `${base}/components`
);
const fundamentals = await getNavigation(
  "lionFundamentals",
  `${base}/fundamentals`,
  false
);
const guides = await getNavigation(
  "lionGuides",
  `${base}/guides`,
  false
);
const blogEntries = await getNavigation(
  "lionBlog",
  `${base}/blog`,
  false,
  entry => entry.data?.published
);

/**
 * @typedef {{name: string; url: string; active?:boolean; hasActiveChild?: boolean; iconId?: string; children?: NavItemData[]}} NavItem
 */

 /** @type {NavItem[]} */
const navData = [
  // {
  //   name: "home",
  //   url: base,
  //   iconId: 'lion-portal:portal:home'
  // },
  {
    name: "fundamentals",
    url: `${base}/fundamentals`,
    children: fundamentals,
  },
  {
    name: "guides",
    url: `${base}/guides`,
    children: guides,
  },
  {
    name: "components",
    url: `${base}/components`,
    children: components,
  },
  {
    name: "blog",
    url: `${base}/blog`,
    children: blogEntries,
  },
];

/**
 * The phone menu's tree, built here rather than by a component that imports itself: Astro cannot render a
 * self-referential component reliably (it failed the build with "value.then is not a function" on every page),
 * so the recursion is plain JS in the frontmatter and the markup lands through set:html. Fragment is built in,
 * so it needs no import.
 *
 * Each group is a native <details>, which brings keyboard support, screen-reader semantics and multiple-open
 * behaviour with it, and no name attribute is set so opening one does not close another. Every level renders,
 * which is the point: a page reachable only through the nav has to be reachable here too, and the flat list this
 * replaces stopped at twelve children per section.
 */
const esc = value => String(value ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

/*
 * Every level of the nav, expanded, without a disclosure to operate: the tree is read, not driven. So the whole
 * list is one markup block, indented a step per level, and nothing is hidden behind a control. The indent is what
 * makes the levels legible — without it the children read as siblings of their parents.
 *
 * An item that is both a link and a parent (a section that has a landing page and pages beneath it) renders as a
 * link with its children following, which is how the desktop nav treats the same data.
 */
const INDENT_STEP = 6;

const menuTree = (items, level = 0) =>
  items
    .map(item => {
      const label = esc(item.name);
      const indent = level > 0 ? ` style="--menu-indent:${level * INDENT_STEP}px"` : '';
      const hasChildren = Boolean(item.children && item.children.length);
      const row = item.url
        ? `<a class="mobile-menu__link" href="${esc(item.url)}" data-level="${level}"${indent}>${label}</a>`
        : item.command
          ? `<button type="button" class="mobile-menu__link" data-command="${esc(item.command)}" data-level="${level}"${indent}>${label}</button>`
          : `<span class="mobile-menu__link" data-level="${level}"${indent}>${label}</span>`;

      /*
       * A section at the top level is a link, always open. Below it a parent becomes a closed accordion, so the
       * tree stays scannable however long it is, and only the levels the reader is working in are unfolded. The
       * indent stays subtle: the disclosure already says "there is more here", so the indent only has to separate
       * a child from its parent, not shout.
       */
      if (hasChildren && level >= 1) {
        const head = item.url
          ? `<a class="mobile-menu__section-link" href="${esc(item.url)}">${label}</a>`
          : `<span>${label}</span>`;
        return `<li><details class="mobile-menu__group"><summary class="mobile-menu__link mobile-menu__summary" data-level="${level}"${indent}>${head}</summary>${menuTree(item.children, level + 1)}</details></li>`;
      }

      const children = hasChildren ? menuTree(item.children, level + 1) : '';
      return `<li>${row}${children}</li>`;
    })
    .join('');

const menuHtml = `<ul class="mobile-menu__list" data-menu-level="0">${menuTree(navData)}</ul>`;

// Add search and github to navData
navData.push(
  {
    name: 'Search',
    // url: '/search',
    iconId: 'lion:portal:search',
    command: 'open-search',
  },
  {
    name: 'GitHub',
    url: 'https://github.com/ing-bank/lion',
    iconId: 'lion:portal:github',
    target: '_blank',
    rel: 'noopener noreferrer',
  }
);

/** @type WeakMap<{NavItem},{NavItem}> */
const itemParents = new WeakMap();

function _setParentsActive(navItem) {
  const parentItem = itemParents.get(navItem);
  if (parentItem) {
    parentItem.hasActiveChild = true;
    _setParentsActive(parentItem);
  }
}

function setParents(navData, parentItem = null) {
  for (const navItem of navData) {
    if (parentItem) {
      itemParents.set(navItem, parentItem);
    }
    if (navItem.children?.length) {
      setParents(navItem.children, navItem);
    }
  }
}

let activeItem;
function setActive(navData, currentUrl) {
  // for home page we need to check with the exact match
  const isActive = (navItem) => {
    if (navItem.url === base) {
      // homepage
      return `${navItem.url}/` === currentUrl;
    }

    // /components/form
    // /components/form-input problem
    return `${currentUrl}/`.startsWith(`${navItem.url}/`);
  }

  for (const navItem of navData) {
    if (isActive(navItem)) {
      navItem.active = true;
      activeItem = navItem;
    }
    if (navItem.children?.length) {
      setActive(navItem.children, currentUrl);
    }
  }
}

setParents(navData);
setActive(navData, Astro.url.pathname);
_setParentsActive(activeItem);

const { variant } = Astro.props;
---

<style>
  .site-header {
    /* Was `background: var(--background-primary)` - a token that exists nowhere in the project, so
     * the bar computed to rgba(0,0,0,0): a pure backdrop-filter with no scrim behind it, which is
     * what made it look smudgy. The themed scrim from styles.css is the intended surface. */
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-border, var(--border-color, #e2e8f0));
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    flex-grow: 0;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-text-svg {
    /* Removed grayscale filter to keep logo intact */
  }

  .site-header :global(.logo svg) {
    /*
     * The mark at the playground page's size, so the two headers are the same mark: 65x27.08 in a 48px bar (56%),
     * against 72x30 before. Applied to the SVG rather than as a font-size, which would shrink only the glyphs and leave
     * the second half at its authored x, opening the gap between the halves.
     */
    width: 65px;
    height: 27.08px;
  }

  :global(.site-header ui-portal-main-nav) {
    flex: 1;
    height: auto;
  }

  /*
   * The bar's own type is smaller — that part of "on par with StackBlitz" holds (their nav links are 13px at weight
   * 500). It sits on `.site-nav` rather than on the whole bar because the nav is what it is for.
   *
   * The wordmark is deliberately untouched, and not for the reason first written here: measured, its SVG text
   * carries its own font-size (32 user units) and inherits nothing from the bar. The mark's apparent smallness came
   * from the weight — at 400 the "lion" glyphs are narrower than the 600 they are drawn for, which opened a 4.2px
   * gap to "ui" where the docs site has 2px. That gap is closed in the page's own stylesheet, on the accent half.
   */
  .site-nav {
    font-size: 0.9375rem;
  }

</style>

<header class="site-header">
    <div class="container">
        <!--
          The phone's menu: our own, modelled on the shape shadcn uses for a small screen — a panel that
          covers the area under the bar, full width, over a dimmed page, with the choices as rows that take a
          fill on hover and a bound radius. It is not their markup: this is a <dialog>, which the platform
          promotes to the top layer, so it escapes the containing blocks that the hero's scroll animation and
          transform create (measured on the theme picker: a fixed panel anchored to the headline instead).
          It also brings ::backdrop, Escape and focus handling with it, and the switch at its foot.

          The links come from the same navData array the desktop nav is built from, so the two cannot drift.
        -->
        <button type="button" class="mobile-menu-toggle" aria-haspopup="dialog" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open the menu">
          <span class="mobile-menu-toggle__icon mobile-menu-toggle__icon--menu" aria-hidden="true">
            <svg viewBox="0 0 28 28" width="20" height="20" fill="currentColor">
              <path d="M4 7C4 6.44771 4.44772 6 5 6H24C24.5523 6 25 6.44771 25 7C25 7.55229 24.5523 8 24 8H5C4.44772 8 4 7.55229 4 7Z" />
              <path d="M4 13.9998C4 13.4475 4.44772 12.9997 5 12.9997L16 13C16.5523 13 17 13.4477 17 14C17 14.5523 16.5523 15 16 15L5 14.9998C4.44772 14.9998 4 14.552 4 13.9998Z" />
              <path d="M5 19.9998C4.44772 19.9998 4 20.4475 4 20.9998C4 21.552 4.44772 21.9997 5 21.9997H22C22.5523 21.9997 23 21.552 23 20.9998C23 20.4475 22.5523 19.9998 22 19.9998H5Z" />
            </svg>
          </span>
          <!-- The close sits in the same place, and the pair is the one thing the view transition morphs. -->
          <span class="mobile-menu-toggle__icon mobile-menu-toggle__icon--close" aria-hidden="true">
            <svg viewBox="0 0 28 28" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <path d="M8 8l12 12M20 8L8 20" />
            </svg>
          </span>
        </button>

        <dialog class="mobile-menu" id="mobile-menu" aria-label="Menu">
          <!-- Our own mark at the head of our own menu, and the close control beside the tree. -->
          <div class="mobile-menu__head">
            <LionWordmark />
            <button type="button" class="mobile-menu__close" aria-label="Close the menu">
              <svg viewBox="0 0 28 28" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                <path d="M8 8l12 12M20 8L8 20" />
              </svg>
            </button>
          </div>
          <nav aria-label="Main navigation">
            <Fragment set:html={menuHtml} />
          </nav>
          <div class="mobile-menu__foot">
            <span class="mobile-menu__foot-label">Theme</span>
            <!--
              The same radio group and the same storage key as the bar's switch, so the mechanism is
              ThemeInit's and not a second one. The ids are prefixed because the bar's copy carries
              theme-*; theme.css and ThemeInit know both spellings.
            -->
            <form class="theme-switch" aria-label="Colour theme">
              <input type="radio" name="theme" id="menu-theme-light" value="light" />
              <label for="menu-theme-light" title="Light theme"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9"/></g></svg></label>
              <input type="radio" name="theme" id="menu-theme-dark" value="dark" />
              <label for="menu-theme-dark" title="Dark theme"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z" fill="currentColor"/></svg></label>
              <input type="radio" name="theme" id="menu-theme-auto" value="auto" />
              <label for="menu-theme-auto" title="Follow the system theme">Auto</label>
            </form>
          </div>
        </dialog>

        <a href=`${base}/` class="logo" aria-label="Lion">
            <LionWordmark />
        </a>
        
        <div class="site-nav">
          <!--
            The theme switch rides *inside* the nav rather than next to it. A `slot` attribute only means something
            when the parent is a shadow host, so the form has to be a child of `UIPortalMainNav` itself — as a
            sibling of the nav it was inert (`assignedSlot` stayed null, measured). UIMainNav renders
            `<slot name="l0-after">` in its level-0 row, which is the row the hamburger lives in.
          -->
          <UIPortalMainNav 
            client:load 
            nav-data={JSON.stringify({ items: toNavLevels(navData) })} 
            variant={variant || ''}
          >
            <!--
              Theme switch. CSS only: the radios set `color-scheme` on :root via :has(), which is the
              only thing light-dark() in styles.css reads. No JavaScript and no stored preference, so
              "Auto" has to be a real option in the group - a reset button could not be checked, which
              left the default state with nothing selected and made the control appear/disappear as
              you used it (see public/styles/theme.css).
            -->
            <!--
              The theme switch is slotted into the nav's *level* rather than its level-0 row: level 0 is the bar the
              hamburger sits in, which is the closed bar on a phone, so a control there stays outside the open drawer.
              The level slot renders in the row on a desktop and inside the drawer on a phone — one element, both
              layouts. See `level-${level}-after` in UIMainNav.
            -->
            <form class="theme-switch" aria-label="Colour theme" slot="level-1-after">
                <input type="radio" name="theme" id="theme-light" value="light" />
                <label for="theme-light" title="Light theme"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9"/></g></svg></label>
                <input type="radio" name="theme" id="theme-dark" value="dark" />
                <label for="theme-dark" title="Dark theme"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z" fill="currentColor"/></svg></label>
                <input type="radio" name="theme" id="theme-auto" value="auto" checked />
                <label for="theme-auto" title="Follow the system theme">Auto</label>
            </form>
          </UIPortalMainNav>
        </div>

        <!--
          The theme switch now lives inside the nav (see the block above), which is where a control that belongs to
          the navigation should be: it travels with the nav, and when the nav collapses to the hamburger it is no
          longer a separate block floating beside it.
        -->
    </div>
</header>

<script>
  // The phone's menu: a modal dialog, so the platform owns Escape, the backdrop and the focus trap. This only
  // has to open and close it, keep aria-expanded honest, and shut it when a link is followed.
  {
    const dialog = document.getElementById('mobile-menu');
    const toggle = document.querySelector('.mobile-menu-toggle');
    if (dialog && toggle) {
      const swap = open => {
        if (open) {
          dialog.showModal();
        } else {
          dialog.close();
        }
        toggle.setAttribute('aria-expanded', String(open));
      };
      /*
       * The icon goes from the menu mark to the close and back, and the pair is the one thing handed to a view
       * transition: the button and its two glyphs are in the same place in both states, so the browser morphs
       * them instead of swapping them. Only the icon carries a view-transition-name, so the sheet itself keeps
       * its own entrance and the top layer is left out of the snapshot. Without startViewTransition the swap is
       * instant, which is the whole fallback.
       */
      const setOpen = open => {
        if (typeof document.startViewTransition === 'function') {
          const transition = document.startViewTransition(() => swap(open));
          /*
           * Chrome refuses to snapshot a modal dialog in the top layer, so BOTH of the transition's promises can
           * reject with "Snapshot capture failed" — and it is the ready promise, not the finished one, that
           * reports it. That is a browser limitation, not a failure of the swap: the swap has already happened,
           * and the icons still cross-fade through their own CSS transition. Catching both keeps the console
           * clean and leaves the effect intact wherever the browser can do it.
           */
          transition.ready?.catch(() => {});
          transition.finished?.catch(() => {});
        } else {
          swap(open);
        }
      };
      toggle.addEventListener('click', () => setOpen(!dialog.open));
      dialog.querySelector('.mobile-menu__close')?.addEventListener('click', () => setOpen(false));
      dialog.addEventListener('close', () => toggle.setAttribute('aria-expanded', 'false'));
      // A tap on the dimmed page closes it: the backdrop is part of the dialog's box, so a click that lands
      // outside the panel's own rect is a click on the backdrop.
      dialog.addEventListener('click', event => {
        const box = dialog.getBoundingClientRect();
        const outside = event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom;
        if (outside) setOpen(false);
      });
      dialog.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
      // The search entry is a command rather than a link, and it dispatches what the nav's own item does.
      dialog.querySelectorAll('[data-command]').forEach(button => {
        button.addEventListener('click', () => {
          document.dispatchEvent(new CustomEvent('search-requested'));
          setOpen(false);
        });
      });
    }
  }

  // Listen for 'open-search' command from UIPortalMainNav
  const setupSearchListener = () => {
    const navElement = document.querySelector('ui-main-nav');

    if (navElement) {
      navElement.addEventListener('open-search', () => {
        // Dispatch custom event that SearchModal listens for
        document.dispatchEvent(new CustomEvent('search-requested'));
      });
    } else {
      // Retry if nav element not found yet
      setTimeout(setupSearchListener, 100);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSearchListener);
  } else {
    setupSearchListener();
  }
</script>

<SearchModal />
